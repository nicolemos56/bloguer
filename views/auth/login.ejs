<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - VIB Music</title>
  <link rel="stylesheet" href="/assets/css/variables.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <style>
    .auth-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
      padding: var(--space-lg);
    }

    .auth-card {
      background: var(--bg-primary);
      border-radius: var(--radius-lg);
      padding: var(--space-xl);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 400px;
    }

    .auth-header {
      text-align: center;
      margin-bottom: var(--space-xl);
    }

    .auth-logo {
      color: var(--accent-primary);
      font-size: 2.4rem;
      font-weight: var(--font-weight-bold);
      margin-bottom: var(--space-sm);
    }

    .auth-subtitle {
      color: var(--text-secondary);
      font-size: 1.4rem;
    }

    .auth-form {
      display: flex;
      flex-direction: column;
      gap: var(--space-lg);
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .form-group label {
      color: var(--text-primary);
      font-weight: var(--font-weight-medium);
      font-size: 1.4rem;
    }

    .form-group input {
      padding: var(--space-md);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      background: var(--bg-secondary);
      color: var(--text-primary);
      font-size: 1.4rem;
      transition: border-color var(--transition-base);
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--accent-primary);
    }

    .auth-button {
      background: var(--accent-primary);
      color: white;
      padding: var(--space-md);
      border: none;
      border-radius: var(--radius-md);
      font-size: 1.6rem;
      font-weight: var(--font-weight-medium);
      cursor: pointer;
      transition: background-color var(--transition-base);
    }

    .auth-button:hover {
      background: var(--accent-secondary);
    }

    .auth-button:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .auth-links {
      text-align: center;
      margin-top: var(--space-lg);
      padding-top: var(--space-lg);
      border-top: 1px solid var(--border-color);
    }

    .auth-links a {
      color: var(--accent-primary);
      text-decoration: none;
      font-weight: var(--font-weight-medium);
    }

    .auth-links a:hover {
      text-decoration: underline;
    }

    .error-message {
      background: #fee;
      color: #c33;
      padding: var(--space-sm);
      border-radius: var(--radius-sm);
      text-align: center;
      margin-bottom: var(--space-md);
    }

    .success-message {
      background: #efe;
      color: #393;
      padding: var(--space-sm);
      border-radius: var(--radius-sm);
      text-align: center;
      margin-bottom: var(--space-md);
    }

    .back-to-site {
      position: fixed;
      top: var(--space-lg);
      left: var(--space-lg);
      color: white;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      background: rgba(255, 255, 255, 0.2);
      padding: var(--space-sm) var(--space-md);
      border-radius: var(--radius-md);
      backdrop-filter: blur(10px);
      transition: background-color var(--transition-base);
    }

    .back-to-site:hover {
      background: rgba(255, 255, 255, 0.3);
      color: white;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <a href="/" class="back-to-site">
    <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
      <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.42-1.41L7.83 13H20v-2z"/>
    </svg>
    Voltar ao site
  </a>

  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <h1 class="auth-logo">VIB Music</h1>
        <p class="auth-subtitle">Faça login para continuar</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message"><%= success %></div>
      <% } %>

      <form class="auth-form" action="/auth/login" method="POST">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required placeholder="seu@email.com">
        </div>
        
        <div class="form-group">
          <label for="password">Palavra-passe</label>
          <input type="password" id="password" name="password" required placeholder="••••••••">
        </div>
        
        <button type="submit" class="auth-button">Entrar</button>
      </form>

      <div class="auth-links">
        <p>Não tem conta? <a href="/auth/register">Criar conta</a></p>
        <p><a href="/auth/forgot-password">Esqueceu a palavra-passe?</a></p>
      </div>
    </div>
  </div>

  <script>
    // Verificar se há parâmetros na URL
    const urlParams = new URLSearchParams(window.location.search);
    const redirect = urlParams.get('redirect');
    
    if (redirect) {
      const form = document.querySelector('.auth-form');
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'redirect';
      input.value = redirect;
      form.appendChild(input);
    }
  </script>
</body>
</html>