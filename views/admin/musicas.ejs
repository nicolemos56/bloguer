<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/assets/css/variables.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body class="admin-body">
  
  <!-- Admin Sidebar -->
  <nav class="admin-sidebar">
    <div class="admin-sidebar-header">
      <h2 class="admin-logo">e Nessa Banda Mekié</h2>
      <span class="admin-badge">Admin</span>
    </div>
    
    <ul class="admin-nav">
      <li><a href="/admin" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
        </svg>
        Dashboard
      </a></li>
      <li><a href="/admin/musicas" class="admin-nav-link active">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Músicas
      </a></li>
      <li><a href="/admin/artistas" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A3 3 0 0 0 16.76 6h-2.52A3 3 0 0 0 11.04 8.37L8.5 16H11v6h9z"/>
        </svg>
        Artistas
      </a></li>
      <li><a href="/admin/categorias" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Categorias
      </a></li>
    </ul>
    
    <div class="admin-sidebar-footer">
      <a href="/" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
        Voltar ao site
      </a>
    </div>
  </nav>

  <!-- Admin Main Content -->
  <main class="admin-main">
    <header class="admin-header">
      <h1 class="admin-title">Gerir Músicas</h1>
      <button class="btn btn-primary" onclick="openAddModal()">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
        </svg>
        Adicionar Música
      </button>
    </header>

    <!-- Filters -->
    <section class="admin-filters">
      <form method="GET" action="/admin/musicas" class="admin-filter-group">
        <input type="text" name="search" placeholder="Pesquisar músicas..." class="admin-search-input" value="<%= typeof filtros !== 'undefined' && filtros.search ? filtros.search : '' %>">
        <select name="categoria" class="admin-filter-select" onchange="this.form.submit()">
          <option value="">Todas as categorias</option>
          <option value="kuduro" <%= typeof filtros !== 'undefined' && filtros.categoria === 'kuduro' ? 'selected' : '' %>>Kuduro</option>
          <option value="raphiphop" <%= typeof filtros !== 'undefined' && filtros.categoria === 'raphiphop' ? 'selected' : '' %>>Rap/Hip-Hop</option>
          <option value="kizomba" <%= typeof filtros !== 'undefined' && filtros.categoria === 'kizomba' ? 'selected' : '' %>>Kizomba</option>
          <option value="semba" <%= typeof filtros !== 'undefined' && filtros.categoria === 'semba' ? 'selected' : '' %>>Semba</option>
          <option value="afrohouse" <%= typeof filtros !== 'undefined' && filtros.categoria === 'afrohouse' ? 'selected' : '' %>>Afro House</option>
          <option value="ghetozouk" <%= typeof filtros !== 'undefined' && filtros.categoria === 'ghetozouk' ? 'selected' : '' %>>Gheto Zouk</option>
        </select>
        <button type="submit" class="btn btn-secondary btn-small">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
          </svg>
          Pesquisar
        </button>
        <% if (typeof filtros !== 'undefined' && (filtros.search || filtros.categoria)) { %>
          <a href="/admin/musicas" class="btn btn-outline btn-small">Limpar Filtros</a>
        <% } %>
      </form>
    </section>

    <!-- Music Table -->
    <section class="admin-content">
      <div class="admin-card">
        <div class="admin-table-container">
          <table class="admin-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Artista</th>
                <th>Categoria</th>
                <th>Duração</th>
                <th>Ano</th>
                <th>Capa</th>
                <th>Música/Link</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% musicas.forEach(musica => { %>
                <tr>
                  <td>#<%= musica.id %></td>
                  <td>
                    <div class="admin-music-info">
                      <strong><%= musica.titulo %></strong>
                    </div>
                  </td>
                  <td><%= musica.artista %></td>
                  <td>
                    <span class="admin-category-badge admin-category-<%= musica.categoria.toLowerCase().replace(/[^a-z]/g, '') %>">
                      <%= musica.categoria %>
                    </span>
                  </td>
                  <td><%= musica.duracao %></td>
                  <td><%= musica.ano || 'N/A' %></td>
                  <td>
                    <div class="admin-cover-image">
                      <img src="<%= musica.cover || '/assets/images/default-cover.jpg' %>" alt="Capa de <%= musica.titulo %>" class="cover-thumbnail">
                    </div>
                  </td>
                  <td>
                    <a href="<%= musica.link %>" class="admin-music-link" target="_blank">
                      <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                      Reproduzir
                    </a>
                  </td>
                  <td>
                    <div class="admin-action-buttons">
                      <button class="admin-btn-small admin-btn-edit" title="Editar" onclick="editMusic(<%= musica.id %>)">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                        </svg>
                      </button>
                      <button class="admin-btn-small admin-btn-delete" title="Remover" onclick="deleteMusic(<%= musica.id %>, '<%= musica.titulo %>')">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </main>

  <!-- Add Music Modal -->
  <div id="addMusicModal" class="admin-modal" style="display: none;">
    <div class="admin-modal-content">
      <div class="admin-modal-header">
        <h2>Adicionar Nova Música</h2>
        <button class="admin-modal-close" onclick="closeAddModal()">&times;</button>
      </div>
      
      <form id="addMusicForm" class="admin-form">
        <div class="admin-form-row">
          <div class="admin-form-group">
            <label>Título da Música</label>
            <input type="text" name="titulo" required placeholder="Ex: Bem Estar">
          </div>
          <div class="admin-form-group">
            <label>Artista</label>
            <select id="artistaSelect" name="artistaSelect" required onchange="toggleArtistaInput()">
              <option value="">Selecionar artista existente</option>
              <% if (artistasExistentes && artistasExistentes.length > 0) { %>
                <% artistasExistentes.forEach(artista => { %>
                  <option value="<%= artista %>"><%= artista %></option>
                <% }) %>
              <% } %>
              <option value="novo">+ Novo artista (digitar nome)</option>
            </select>
            <input type="text" id="artistaTexto" name="artista" style="display: none; margin-top: 10px;" placeholder="Digite o nome do novo artista">
          </div>
        </div>
        
        <div class="admin-form-row">
          <div class="admin-form-group">
            <label>Categoria</label>
            <select name="categoria" required>
              <option value="">Selecionar categoria</option>
              <option value="Kuduro">Kuduro</option>
              <option value="Rap">Rap/Hip-Hop</option>
              <option value="Kizomba">Kizomba</option>
              <option value="Semba">Semba</option>
              <option value="Afro House">Afro House</option>
              <option value="Gheto Zouk">Gheto Zouk</option>
            </select>
          </div>
          <div class="admin-form-group">
            <label>Duração</label>
            <input type="text" name="duracao" required placeholder="Ex: 4:23">
          </div>
        </div>
        
        <div class="admin-form-row">
          <div class="admin-form-group">
            <label>Álbum</label>
            <input type="text" name="album" placeholder="Ex: Nha Vida">
          </div>
          <div class="admin-form-group">
            <label>Ano de Lançamento</label>
            <input type="number" name="ano" placeholder="Ex: 2024" min="1900" max="2050">
          </div>
        </div>
        
        <div class="admin-form-row">
          <div class="admin-form-group">
            <label>Arquivo de Música</label>
            <input type="file" name="musicFile" accept="audio/*" required>
          </div>
        </div>
        
        <div class="admin-form-group">
          <label>Imagem da Capa</label>
          <input type="file" name="coverImage" accept="image/*">
        </div>
        
        <div class="admin-form-actions">
          <button type="button" class="btn btn-secondary" onclick="closeAddModal()">Cancelar</button>
          <button type="submit" class="btn btn-primary">Adicionar Música</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openAddModal() {
      document.getElementById('addMusicModal').style.display = 'block';
    }
    
    function closeAddModal() {
      document.getElementById('addMusicModal').style.display = 'none';
      document.getElementById('addMusicForm').reset();
    }
    
    function editMusic(id) {
      alert('Funcionalidade de edição será implementada para música ID: ' + id);
    }
    
    function deleteMusic(id, title) {
      if (confirm('Tem certeza que deseja remover a música "' + title + '"?')) {
        fetch('/admin/musicas/' + id, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            alert(data.message);
            location.reload();
          }
        })
        .catch(error => {
          console.error('Erro:', error);
          alert('Erro ao remover música');
        });
      }
    }
    
    // Função para alternar entre dropdown e input de texto para artista
    function toggleArtistaInput() {
      const artistaSelect = document.getElementById('artistaSelect');
      const artistaTexto = document.getElementById('artistaTexto');
      
      if (artistaSelect.value === 'novo') {
        artistaTexto.style.display = 'block';
        artistaTexto.required = true;
        artistaSelect.removeAttribute('name'); // Remove name do select
        artistaTexto.name = 'artista'; // Adiciona name ao input
      } else if (artistaSelect.value !== '') {
        artistaTexto.style.display = 'none';
        artistaTexto.required = false;
        artistaSelect.name = 'artista'; // Adiciona name ao select
        artistaTexto.removeAttribute('name'); // Remove name do input
        artistaTexto.value = artistaSelect.value; // Copia valor selecionado
      } else {
        artistaTexto.style.display = 'none';
        artistaTexto.required = false;
        artistaSelect.name = 'artista';
        artistaTexto.removeAttribute('name');
      }
    }

    document.getElementById('addMusicForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Garantir que o artista está definido corretamente
      const artistaSelect = document.getElementById('artistaSelect');
      const artistaTexto = document.getElementById('artistaTexto');
      
      if (artistaSelect.value === 'novo') {
        if (!artistaTexto.value.trim()) {
          alert('Por favor, digite o nome do artista.');
          return;
        }
      } else if (!artistaSelect.value) {
        alert('Por favor, selecione um artista ou digite um novo.');
        return;
      }
      
      const formData = new FormData(this);
      
      fetch('/admin/musicas/add', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert(data.message);
          closeAddModal();
          location.reload();
        }
      })
      .catch(error => {
        console.error('Erro:', error);
        alert('Erro ao adicionar música');
      });
    });
    
    // Close modal when clicking outside
    window.addEventListener('click', function(event) {
      const modal = document.getElementById('addMusicModal');
      if (event.target === modal) {
        closeAddModal();
      }
    });
  </script>

  <!-- Admin Footer -->
  <footer class="admin-footer">
    <div class="admin-footer-content">
      <p>&copy; 2025 e Nessa Banda Mekié. Todos os direitos reservados.</p>
    </div>
  </footer>

</body>
</html>