<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/assets/css/variables.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body class="admin-body">
  
  <!-- Admin Sidebar -->
  <nav class="admin-sidebar">
    <div class="admin-sidebar-header">
      <h2 class="admin-logo">e Nessa Banda Mekié</h2>
      <span class="admin-badge">Admin</span>
    </div>
    
    <ul class="admin-nav">
      <li><a href="/admin" class="admin-nav-link active">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
        </svg>
        Dashboard
      </a></li>
      <li><a href="/admin/musicas" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Músicas
      </a></li>
      <li><a href="/admin/artistas" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A3 3 0 0 0 16.76 6h-2.52A3 3 0 0 0 11.04 8.37L8.5 16H11v6h9z"/>
        </svg>
        Artistas
      </a></li>
      <li><a href="/admin/categorias" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Categorias
      </a></li>
      <li><a href="/admin/pedidos" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
        </svg>
        Pedidos
      </a></li>
    </ul>
    
    <div class="admin-sidebar-footer">
      <a href="/" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
        Voltar ao site
      </a>
    </div>
  </nav>

  <!-- Admin Main Content -->
  <main class="admin-main">
    <header class="admin-header">
      <div class="admin-header-content">
        <div class="admin-title-section">
          <h1 class="admin-title">Dashboard</h1>
          <p class="admin-subtitle">Painel de controle e gestão da plataforma</p>
        </div>
        <div class="admin-user">
          <span>Bem-vindo, Admin</span>
          <div class="admin-user-avatar">A</div>
        </div>
      </div>
    </header>

    <!-- Overview Stats -->
    <section class="dashboard-overview">
      <div class="overview-grid">
        <div class="stat-card music-card">
          <div class="stat-header">
            <div class="stat-icon music-icon">
              <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
              </svg>
            </div>
            <div class="stat-trend">+12%</div>
          </div>
          <div class="stat-content">
            <h3 class="stat-number"><%= stats.totalMusicas %></h3>
            <p class="stat-label">Total de Músicas</p>
            <span class="stat-subtext">Biblioteca completa</span>
          </div>
        </div>
        
        <div class="stat-card artists-card">
          <div class="stat-header">
            <div class="stat-icon artists-icon">
              <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24">
                <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A3 3 0 0 0 16.76 6h-2.52A3 3 0 0 0 11.04 8.37L8.5 16H11v6h9z"/>
              </svg>
            </div>
            <div class="stat-trend">+5%</div>
          </div>
          <div class="stat-content">
            <h3 class="stat-number"><%= stats.totalArtistas %></h3>
            <p class="stat-label">Artistas Registados</p>
            <span class="stat-subtext">Talentos na plataforma</span>
          </div>
        </div>
        
        <div class="stat-card plays-card">
          <div class="stat-header">
            <div class="stat-icon plays-icon">
              <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <div class="stat-trend">+28%</div>
          </div>
          <div class="stat-content">
            <h3 class="stat-number"><%= stats.totalPlays %></h3>
            <p class="stat-label">Total de Reproduções</p>
            <span class="stat-subtext">Engagement dos usuários</span>
          </div>
        </div>
        
        <div class="stat-card categories-card">
          <div class="stat-header">
            <div class="stat-icon categories-icon">
              <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <div class="stat-trend">+2%</div>
          </div>
          <div class="stat-content">
            <h3 class="stat-number"><%= stats.totalCategorias %></h3>
            <p class="stat-label">Categorias Musicais</p>
            <span class="stat-subtext">Géneros disponíveis</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Dashboard Content Grid -->
    <div class="dashboard-grid">
      <!-- Left Column -->
      <div class="dashboard-left">
        <!-- Recent Activity -->
        <div class="dashboard-card recent-activity">
          <div class="card-header">
            <h2>Atividade Recente</h2>
            <a href="/admin/musicas" class="btn btn-primary btn-small">Ver todas</a>
          </div>
          
          <div class="recent-items">
            <% stats.musicasRecentes.forEach(musica => { %>
              <div class="recent-item">
                <div class="recent-icon">
                  <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                  </svg>
                </div>
                <div class="recent-content">
                  <h4><%= musica.titulo %></h4>
                  <p><%= musica.artista %> • <%= musica.data %></p>
                </div>
                <div class="recent-stats">
                  <span class="plays-count"><%= musica.plays %> reproduções</span>
                </div>
              </div>
            <% }) %>
          </div>
        </div>
        
        <!-- Quick Actions -->
        <div class="dashboard-card quick-actions">
          <div class="card-header">
            <h2>Ações Rápidas</h2>
          </div>
          
          <div class="actions-grid">
            <a href="/admin/musicas" class="action-item add-music">
              <div class="action-icon">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                </svg>
              </div>
              <div class="action-content">
                <h4>Adicionar Música</h4>
                <p>Subir nova música</p>
              </div>
            </a>
            
            <a href="/admin/artistas" class="action-item add-artist">
              <div class="action-icon">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                </svg>
              </div>
              <div class="action-content">
                <h4>Adicionar Artista</h4>
                <p>Registar novo artista</p>
              </div>
            </a>
            
            <a href="/admin/categorias" class="action-item manage-categories">
              <div class="action-icon">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
              <div class="action-content">
                <h4>Gerir Categorias</h4>
                <p>Organizar géneros</p>
              </div>
            </a>
            
            <a href="/admin/pedidos" class="action-item view-requests">
              <div class="action-icon">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/>
                </svg>
              </div>
              <div class="action-content">
                <h4>Ver Pedidos</h4>
                <p>Gerir promoções</p>
              </div>
            </a>
          </div>
        </div>
      </div>
      
      <!-- Right Column -->
      <div class="dashboard-right">
        <!-- System Status -->
        <div class="dashboard-card system-status">
          <div class="card-header">
            <h2>Estado do Sistema</h2>
          </div>
          
          <div class="status-items">
            <div class="status-item">
              <div class="status-indicator online"></div>
              <span>Servidor Online</span>
            </div>
            <div class="status-item">
              <div class="status-indicator online"></div>
              <span>Base de Dados</span>
            </div>
            <div class="status-item">
              <div class="status-indicator warning"></div>
              <span>Armazenamento (85%)</span>
            </div>
          </div>
        </div>
        
        <!-- Quick Links -->
        <div class="dashboard-card quick-links">
          <div class="card-header">
            <h2>Links Rápidos</h2>
          </div>
          
          <div class="links-list">
            <a href="/" class="quick-link">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
              <span>Ver Website</span>
            </a>
            <a href="/admin/musicas" class="quick-link">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
              </svg>
              <span>Gerir Músicas</span>
            </a>
            <a href="/admin/artistas" class="quick-link">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A3 3 0 0 0 16.76 6h-2.52A3 3 0 0 0 11.04 8.37L8.5 16H11v6h9z"/>
              </svg>
              <span>Gerir Artistas</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Admin Footer -->
  <footer class="admin-footer">
    <div class="admin-footer-content">
      <p>&copy; 2025 e Nessa Banda Mekié. Todos os direitos reservados.</p>
    </div>
  </footer>

</body>
</html>