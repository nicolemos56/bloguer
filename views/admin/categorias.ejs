<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/assets/css/variables.css">
  <link rel="stylesheet" href="/assets/css/components.css">
  <link rel="stylesheet" href="/assets/css/admin.css">
</head>
<body class="admin-body">
  
  <!-- Admin Sidebar -->
  <nav class="admin-sidebar">
    <div class="admin-sidebar-header">
      <h2 class="admin-logo">e Nessa Banda Mekié</h2>
      <span class="admin-badge">Admin</span>
    </div>
    
    <ul class="admin-nav">
      <li><a href="/admin" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/>
        </svg>
        Dashboard
      </a></li>
      <li><a href="/admin/musicas" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Músicas
      </a></li>
      <li><a href="/admin/artistas" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M16 4c0-1.11.89-2 2-2s2 .89 2 2-.89 2-2 2-2-.89-2-2zm4 18v-6h2.5l-2.54-7.63A3 3 0 0 0 16.76 6h-2.52A3 3 0 0 0 11.04 8.37L8.5 16H11v6h9z"/>
        </svg>
        Artistas
      </a></li>
      <li><a href="/admin/categorias" class="admin-nav-link active">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        Categorias
      </a></li>
    </ul>
    
    <div class="admin-sidebar-footer">
      <a href="/" class="admin-nav-link">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
        </svg>
        Voltar ao site
      </a>
    </div>
  </nav>

  <!-- Admin Main Content -->
  <main class="admin-main">
    <header class="admin-header">
      <h1 class="admin-title">Gerir Categorias</h1>
    </header>

    <!-- Categories Grid -->
    <section class="admin-content">
      <div class="admin-categories-grid">
        <% categorias.forEach(categoria => { %>
          <div class="admin-category-card">
            <div class="admin-category-header" style="background-color: <%= categoria.cor %>;">
              <h3><%= categoria.nome %></h3>
              <div class="admin-category-actions">
                <button class="admin-category-btn" onclick="editCategory(<%= categoria.id %>)" title="Editar">
                  <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                  </svg>
                </button>
                <button class="admin-category-btn" onclick="viewCategory('<%= categoria.id %>')" title="Ver categoria">
                  <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>
                  </svg>
                </button>
              </div>
            </div>
            
            <div class="admin-category-body">
              <div class="admin-category-stats">
                <div class="admin-category-stat">
                  <span class="stat-number"><%= categoria.musicas %></span>
                  <span class="stat-label">Músicas</span>
                </div>
                <div class="admin-category-stat">
                  <span class="stat-number"><%= categoria.artistas %></span>
                  <span class="stat-label">Artistas</span>
                </div>
              </div>
              
              <div class="admin-category-info">
                <div class="admin-category-status">
                  <span class="admin-status-badge admin-status-<%= categoria.status.toLowerCase() %>">
                    <%= categoria.status %>
                  </span>
                </div>
                <div class="admin-category-color-preview">
                  <span>Cor:</span>
                  <div class="color-circle" style="background-color: <%= categoria.cor %>;"></div>
                  <code><%= categoria.cor %></code>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
      
      <!-- Category Management Tools -->
      <div class="admin-card admin-category-tools">
        <div class="admin-card-header">
          <h2>Ferramentas de Categoria</h2>
        </div>
        
        <div class="admin-tools-grid">
          <div class="admin-tool-item">
            <div class="admin-tool-icon">
              <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
              </svg>
            </div>
            <h4>Criar Nova Categoria</h4>
            <p>Adicione uma nova categoria musical à plataforma</p>
            <button class="btn btn-primary btn-small" onclick="createCategory()">Criar Categoria</button>
          </div>
          
          <div class="admin-tool-item">
            <div class="admin-tool-icon">
              <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <h4>Reordenar Categorias</h4>
            <p>Altere a ordem de exibição das categorias</p>
            <button class="btn btn-secondary btn-small" onclick="reorderCategories()">Reordenar</button>
          </div>
          
          <div class="admin-tool-item">
            <div class="admin-tool-icon">
              <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
                <path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/>
              </svg>
            </div>
            <h4>Configurações Globais</h4>
            <p>Configure as definições gerais das categorias</p>
            <button class="btn btn-accent btn-small" onclick="categorySettings()">Configurar</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    function editCategory(id) {
      alert('Funcionalidade de edição será implementada para categoria ID: ' + id);
    }
    
    function viewCategory(id) {
      window.open('/categoria/' + id, '_blank');
    }
    
    function createCategory() {
      alert('Modal de criação de categoria será implementado');
    }
    
    function reorderCategories() {
      alert('Interface de reordenação será implementada');
    }
    
    function categorySettings() {
      alert('Página de configurações será implementada');
    }
  </script>

  <!-- Admin Footer -->
  <footer class="admin-footer">
    <div class="admin-footer-content">
      <p>&copy; 2025 e Nessa Banda Mekié. Todos os direitos reservados.</p>
    </div>
  </footer>

</body>
</html>