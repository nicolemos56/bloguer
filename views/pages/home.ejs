<!-- Hero Section -->
<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">VIB MUSIC</h1>
      <h2 class="hero-subtitle">Ouça e divulgue aqui as suas músicas</h2>
      <p class="hero-description">Telefone: +244 942 424</p>
      <div class="hero-actions">
        <a href="/divulgar" class="btn btn-primary">Divulgar</a>
      </div>
    </div>
  </div>
</section>

<!-- Info Section -->
<section class="info-section">
  <div class="container">
    <div class="info-content">
      <h2>Se você é músico ou artista e deseja ver a sua música no top</h2>
      <p>Clique já em divulgar e vê a tua música a bater!</p>
    </div>
  </div>
</section>

<!-- Recent Music Section -->
<section class="artists-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Músicas recentes</h2>
    </div>
    
    <div class="artists-grid">
      <% // Usando dados de músicas recentes do controller
      const musicasRec = (typeof musicasRecentes !== 'undefined') ? musicasRecentes : []; %>
      
      <% musicasRec.forEach(musica => { %>
        <article class="artist-card">
          <div class="artist-image">
            <img src="<%= musica.imagem || '/assets/imagens/imagens_musicas/default.jpg' %>" alt="<%= musica.titulo %>">
          </div>
          <div class="artist-info">
            <h3 class="artist-name"><%= musica.artista %></h3>
            <p class="artist-description"><%= musica.titulo %> <%= musica.ano %></p>
            <div class="artist-actions">
              <% if (musica.arquivo || musica.link) { %>
                <button class="btn btn-secondary" onclick="playMusic('<%= musica.id %>', '<%= musica.titulo %>', '<%= musica.artista %>', '<%= musica.arquivo || musica.link %>', '<%= musica.imagem || musica.cover %>')">Ouvir agora</button>
                <a href="/download/<%= musica.id %>" class="btn btn-accent">Baixar agora</a>
              <% } else { %>
                <button class="btn btn-secondary" disabled>Ouvir agora</button>
                <button class="btn btn-accent" disabled>Baixar agora</button>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- Popular Tracks Section -->
<section class="popular-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Mais curtidas</h2>
      <p class="section-subtitle">As músicas mais populares da plataforma</p>
    </div>
    
    <div class="popular-tracks-grid">
      <% // Usando APENAS dados dinâmicos do controller - SEM fallback estático
      const musicasPopulares = (typeof musicasEmDestaque !== 'undefined') ? musicasEmDestaque : []; %>
      
      <% musicasPopulares.forEach((musica, index) => { %>
        <article class="popular-track-card" data-rank="<%= index + 1 %>">
          <div class="track-rank">
            <span class="rank-number">#<%= index + 1 %></span>
          </div>
          
          <div class="track-image-container">
            <img src="<%= musica.cover || '/assets/imagens/imagens_artistas/' + (musica.imagem || 'default.jpg') %>" alt="<%= musica.titulo %>">
            <div class="track-overlay">
              <% if (musica.arquivo || musica.link) { %>
                <button class="track-play-btn" title="Reproduzir" onclick="playMusic('<%= musica.id %>', '<%= musica.titulo %>', '<%= musica.artista %>', '<%= musica.arquivo || musica.link %>', '<%= musica.cover || musica.imagem %>')">
              <% } else { %>
                <button class="track-play-btn" title="Reproduzir" disabled>
              <% } %>
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
              <a href="/download/<%= musica.id %>" class="track-download-btn" title="Download">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              <% if (musica.link) { %>
                </a>
              <% } else { %>
                </button>
              <% } %>
            </div>
            <div class="track-category-badge"><%= musica.categoria %></div>
          </div>
          
          <div class="track-details">
            <div class="track-main-info">
              <a href="#" class="track-artist-link"><%= musica.artista %></a>
              <h3 class="track-title-main"><%= musica.titulo %></h3>
              <p class="track-year"><%= musica.ano || new Date().getFullYear() %></p>
            </div>
            
            <div class="track-meta">
              <div class="track-stats">
                <span class="track-duration">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                  <%= musica.duracao %>
                </span>
                <span class="track-plays">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <span class="play-count"><%= musica.plays || 0 %></span>
                </span>
              </div>
              
              <div class="track-actions">
                <button class="action-btn-small like-btn" data-music-id="<%= musica.id %>" title="Curtir música">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                  <span class="like-count"><%= musica.likes || 0 %></span>
                </button>
                <button class="action-btn-small" title="Compartilhar">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.50-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/>
                  </svg>
                </button>
                <button class="action-btn-small" title="Mais opções">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    
    <div class="popular-section-footer">
      <a href="/categorias" class="btn btn-secondary btn-large">Ver todas as categorias</a>
    </div>
  </div>
</section>


<!-- Player de Música Modal -->
<div id="musicPlayer" class="music-player-modal hidden">
  <div class="modal-backdrop"></div>
  <div class="player-modal-content">
    <div class="player-header">
      <h3 id="playerTrackTitle">Nome da Música</h3>
      <button id="closePlayerBtn" class="close-player-btn">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
    
    <div class="player-body">
      <div class="player-cover-section">
        <img id="playerCoverImg" src="" alt="Capa da música" class="player-cover-large">
      </div>
      
      <div class="player-info-section">
        <h4 id="playerTrackName">Nome da Música</h4>
        <p id="playerArtistName">Nome do Artista</p>
      </div>
      
      <div class="player-controls-section">
        <div class="player-controls">
          <button id="prevBtn" class="player-btn">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
            </svg>
          </button>
          <button id="playPauseBtn" class="player-btn player-btn-main">
            <svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
          <button id="nextBtn" class="player-btn">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
            </svg>
          </button>
        </div>
        
        <div class="player-progress">
          <div class="time-display">
            <span id="currentTime">0:00</span>
            <div class="progress-bar">
              <div id="progressFill" class="progress-fill"></div>
              <input type="range" id="progressSlider" class="progress-slider" min="0" max="100" value="0">
            </div>
            <span id="totalTime">0:00</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <audio id="audioElement" preload="metadata"></audio>
</div>

<!-- Modal de Login -->
<div id="loginModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Login Necessário</h3>
      <button class="modal-close" onclick="closeLoginModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p id="loginMessage">Para continuar, precisa fazer login na sua conta e Nessa Bamda Mekié.</p>
      <div class="login-actions">
        <button class="btn btn-primary" onclick="alert('Funcionalidade de login será implementada em breve!')">Fazer Login</button>
        <button class="btn btn-secondary" onclick="closeLoginModal()">Cancelar</button>
      </div>
    </div>
  </div>
</div>

<script>
// Variável global para armazenar ação pendente
let acaoPendente = null;

// Verificar estado do usuário quando página carrega
document.addEventListener('DOMContentLoaded', async function() {
  await verificarEstadoUsuario();
});

// Função para verificar e atualizar estado dos botões
async function verificarEstadoUsuario() {
  try {
    const token = localStorage.getItem('vibToken');
    if (!token) return; // Se não há token, usuário não está logado
    
    const response = await fetch('/user/state', {
      headers: {
        'Authorization': token
      }
    });
    
    const data = await response.json();
    
    if (data.loggedIn) {
      // Atualizar botões de seguir artistas
      if (data.artistasFavoritos && data.artistasFavoritos.length > 0) {
        // Buscar todos os artistas para fazer comparação
        const allArtistsResponse = await fetch('/api/artistas');
        if (allArtistsResponse.ok) {
          const allArtists = await allArtistsResponse.json();
          
          document.querySelectorAll('.follow-btn[data-artist]').forEach(btn => {
            const artistName = btn.dataset.artist;
            const foundArtist = allArtists.find(a => a.nome === artistName);
            
            if (foundArtist && data.artistasFavoritos.includes(foundArtist.id)) {
              btn.textContent = 'Seguindo';
              btn.classList.add('following');
            }
          });
        }
      }
      
      // Atualizar botões de curtir músicas
      document.querySelectorAll('.like-btn[data-music-id]').forEach(btn => {
        const musicId = parseInt(btn.dataset.musicId);
        
        if (data.musicasCurtidas.includes(musicId)) {
          btn.classList.add('liked');
        }
      });
    }
  } catch (error) {
    console.error('Erro ao verificar estado do usuário:', error);
  }
}

// Sistema de curtidas
document.querySelectorAll('.like-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const musicId = this.dataset.musicId;
    await tentarCurtirMusica(musicId, this);
  });
});

// Função para tentar curtir música
async function tentarCurtirMusica(musicId, btnElement) {
  try {
    const token = localStorage.getItem('vibToken');
    const response = await fetch(`/like/${musicId}`, { 
      method: 'POST',
      headers: {
        'Authorization': token,
        'Content-Type': 'application/json'
      }
    });
    
    const data = await response.json();
    
    if (data.needLogin) {
      // Armazenar ação para executar após login
      acaoPendente = {
        tipo: 'curtir',
        musicId: musicId,
        elemento: btnElement
      };
      showLoginModal(data.message);
    } else if (data.success) {
      // Atualizar interface baseado no estado
      const likeCount = btnElement.querySelector('.like-count');
      if (data.liked) {
        btnElement.classList.add('liked');
      } else {
        btnElement.classList.remove('liked');
      }
      if (likeCount) {
        likeCount.textContent = data.totalLikes;
      }
    }
  } catch (error) {
    console.error('Erro ao curtir música:', error);
  }
}

// Sistema de seguir artista
document.querySelectorAll('.follow-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const artist = this.dataset.artist;
    await tentarSeguirArtista(artist, this);
  });
});

// Função para tentar seguir artista
async function tentarSeguirArtista(artist, btnElement) {
  try {
    const token = localStorage.getItem('vibToken');
    const response = await fetch(`/follow/${encodeURIComponent(artist)}`, { 
      method: 'POST',
      headers: {
        'Authorization': token,
        'Content-Type': 'application/json'
      }
    });
    
    const data = await response.json();
    
    if (data.needLogin) {
      // Armazenar ação para executar após login
      acaoPendente = {
        tipo: 'seguir',
        artist: artist,
        elemento: btnElement
      };
      showLoginModal(data.message);
    } else if (data.success) {
      // Atualizar interface baseado no estado
      if (data.following) {
        btnElement.textContent = 'Seguindo';
        btnElement.classList.add('following');
      } else {
        btnElement.textContent = 'Seguir';
        btnElement.classList.remove('following');
      }
    }
  } catch (error) {
    console.error('Erro ao seguir artista:', error);
  }
}

// Os plays são registrados automaticamente pela função playMusic() do modal player

// Funções do modal
function showLoginModal(message) {
  document.getElementById('loginMessage').textContent = message;
  document.getElementById('loginModal').style.display = 'flex';
}

function closeLoginModal() {
  document.getElementById('loginModal').style.display = 'none';
}

// Executar ação pendente após login na home
window.executarAcaoPendente = async function() {
  if (acaoPendente) {
    if (acaoPendente.tipo === 'seguir') {
      await tentarSeguirArtista(acaoPendente.artist, acaoPendente.elemento);
    } else if (acaoPendente.tipo === 'curtir') {
      await tentarCurtirMusica(acaoPendente.musicId, acaoPendente.elemento);
    }
    acaoPendente = null; // Limpar ação pendente
  }
}

// Fechar modal clicando fora
document.getElementById('loginModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeLoginModal();
  }
});

// === MUSIC PLAYER FUNCTIONALITY ===
// Sistema de Player de Música Interno
class MusicPlayer {
  constructor() {
    this.audio = document.getElementById('audioElement');
    this.player = document.getElementById('musicPlayer');
    this.playPauseBtn = document.getElementById('playPauseBtn');
    this.prevBtn = document.getElementById('prevBtn');
    this.nextBtn = document.getElementById('nextBtn');
    this.closeBtn = document.getElementById('closePlayerBtn');
    this.progressSlider = document.getElementById('progressSlider');
    this.progressFill = document.getElementById('progressFill');
    this.currentTimeEl = document.getElementById('currentTime');
    this.totalTimeEl = document.getElementById('totalTime');
    this.coverImg = document.getElementById('playerCoverImg');
    this.trackTitle = document.getElementById('playerTrackTitle');
    this.artistName = document.getElementById('playerArtistName');
    
    this.playlist = [];
    this.currentIndex = 0;
    this.isPlaying = false;
    
    this.setupEventListeners();
  }
  
  setupEventListeners() {
    if (!this.audio) return;
    
    this.playPauseBtn?.addEventListener('click', () => this.togglePlayPause());
    this.prevBtn?.addEventListener('click', () => this.previousTrack());
    this.nextBtn?.addEventListener('click', () => this.nextTrack());
    this.closeBtn?.addEventListener('click', () => this.closePlayer());
    
    this.audio.addEventListener('loadedmetadata', () => {
      this.totalTimeEl.textContent = this.formatTime(this.audio.duration);
      this.progressSlider.max = this.audio.duration;
    });
    
    this.audio.addEventListener('timeupdate', () => {
      if (!this.progressSlider.getAttribute('data-dragging')) {
        const progress = (this.audio.currentTime / this.audio.duration) * 100;
        this.progressFill.style.width = progress + '%';
        this.progressSlider.value = this.audio.currentTime;
      }
      this.currentTimeEl.textContent = this.formatTime(this.audio.currentTime);
    });
    
    this.progressSlider?.addEventListener('mousedown', () => {
      this.progressSlider.setAttribute('data-dragging', 'true');
    });
    
    this.progressSlider?.addEventListener('mouseup', () => {
      this.audio.currentTime = this.progressSlider.value;
      this.progressSlider.removeAttribute('data-dragging');
    });
    
    this.audio.addEventListener('ended', () => this.nextTrack());
    
    // Fechar modal clicando no backdrop
    document.querySelector('.modal-backdrop')?.addEventListener('click', () => {
      this.closePlayer();
    });
  }
  
  loadPlaylist(tracks, startIndex = 0) {
    this.playlist = tracks;
    this.currentIndex = startIndex;
    this.loadCurrentTrack();
    this.showPlayer();
  }
  
  loadCurrentTrack() {
    if (this.playlist.length === 0) return;
    
    const track = this.playlist[this.currentIndex];
    this.audio.src = track.arquivo || track.link;
    this.trackTitle.textContent = track.nome || track.titulo;
    document.getElementById('playerTrackName').textContent = track.nome || track.titulo;
    this.artistName.textContent = track.artista;
    this.coverImg.src = track.imagem || track.cover || '/assets/imagens/imagens_musicas/default-cover.jpg';
    
    // Reset progress
    this.progressFill.style.width = '0%';
    this.currentTimeEl.textContent = '0:00';
    
    // Auto play
    if (this.isPlaying) {
      this.audio.play();
    }
    
    // Registrar play
    fetch(`/play/${track.id}`, { method: 'POST' })
      .catch(error => console.error('Erro ao registrar play:', error));
  }
  
  togglePlayPause() {
    if (this.audio.paused) {
      this.audio.play();
      this.playPauseBtn.innerHTML = '<svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';
      this.isPlaying = true;
    } else {
      this.audio.pause();
      this.playPauseBtn.innerHTML = '<svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
      this.isPlaying = false;
    }
  }
  
  previousTrack() {
    this.currentIndex = (this.currentIndex - 1 + this.playlist.length) % this.playlist.length;
    this.loadCurrentTrack();
    if (this.isPlaying) this.audio.play();
  }
  
  nextTrack() {
    this.currentIndex = (this.currentIndex + 1) % this.playlist.length;
    this.loadCurrentTrack();
    if (this.isPlaying) this.audio.play();
  }
  
  showPlayer() {
    this.player.classList.remove('hidden');
    document.body.classList.add('player-active');
    document.body.style.overflow = 'hidden'; // Prevent scroll when modal is open
  }
  
  closePlayer() {
    this.audio.pause();
    this.player.classList.add('hidden');
    document.body.classList.remove('player-active');
    document.body.style.overflow = ''; // Restore scroll
    this.isPlaying = false;
    this.playPauseBtn.innerHTML = '<svg width="28" height="28" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>';
  }
  
  formatTime(seconds) {
    if (isNaN(seconds) || seconds < 0) return '0:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }
}

// Inicializar o player
const musicPlayer = new MusicPlayer();

// Função para tocar uma música individual
function playMusic(id, titulo, artista, arquivo, cover) {
  const track = {
    id: id,
    titulo: titulo,
    nome: titulo,
    artista: artista,
    arquivo: arquivo,
    link: arquivo,
    cover: cover,
    imagem: cover
  };
  
  musicPlayer.loadPlaylist([track], 0);
}
</script>