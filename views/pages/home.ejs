<!-- Hero Section -->
<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">VIB MUSIC</h1>
      <h2 class="hero-subtitle">Ouça e divulgue aqui as suas músicas</h2>
      <p class="hero-description">Telefone: +244 942 424</p>
      <div class="hero-actions">
        <a href="/divulgar" class="btn btn-primary">Divulgar</a>
      </div>
    </div>
  </div>
</section>

<!-- Info Section -->
<section class="info-section">
  <div class="container">
    <div class="info-content">
      <h2>Se você é músico ou artista e deseja ver a sua música no top</h2>
      <p>Clique já em divulgar e vê a tua música a bater!</p>
    </div>
  </div>
</section>

<!-- Recent Music Section -->
<section class="recent-music-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Músicas recentes</h2>
    </div>
    
    <div class="recent-music-grid">
      <% // Usando dados de músicas recentes do controller
      const musicasRec = (typeof musicasRecentes !== 'undefined') ? musicasRecentes : []; %>
      
      <% musicasRec.forEach(musica => { %>
        <article class="recent-music-card">
          <div class="music-image">
            <img src="<%= musica.imagem || '/assets/imagens/imagens_musicas/default.jpg' %>" alt="<%= musica.titulo %>">
            <div class="music-overlay">
              <% if (musica.arquivo) { %>
                <a href="<%= musica.arquivo %>" class="music-play-btn" title="Reproduzir" target="_blank">
              <% } else { %>
                <button class="music-play-btn" title="Reproduzir">
              <% } %>
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              <% if (musica.arquivo) { %>
                </a>
              <% } else { %>
                </button>
              <% } %>
            </div>
          </div>
          <div class="music-info">
            <h3 class="music-artist"><%= musica.artista %></h3>
            <p class="music-title-year"><%= musica.titulo %> <%= musica.ano %></p>
            <div class="music-actions">
              <% if (musica.arquivo) { %>
                <a href="<%= musica.arquivo %>" class="btn btn-secondary" target="_blank">Ouvir agora</a>
                <a href="/download/<%= musica.id %>" class="btn btn-accent">Baixar agora</a>
              <% } else { %>
                <button class="btn btn-secondary">Ouvir agora</button>
                <button class="btn btn-accent">Baixar agora</button>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- Popular Tracks Section -->
<section class="popular-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Mais curtidas</h2>
      <p class="section-subtitle">As músicas mais populares da plataforma</p>
    </div>
    
    <div class="popular-tracks-grid">
      <% // Usando APENAS dados dinâmicos do controller - SEM fallback estático
      const musicasPopulares = (typeof musicasEmDestaque !== 'undefined') ? musicasEmDestaque : []; %>
      
      <% musicasPopulares.forEach((musica, index) => { %>
        <article class="popular-track-card" data-rank="<%= index + 1 %>">
          <div class="track-rank">
            <span class="rank-number">#<%= index + 1 %></span>
          </div>
          
          <div class="track-image-container">
            <img src="<%= musica.cover || '/assets/imagens/imagens_artistas/' + (musica.imagem || 'default.jpg') %>" alt="<%= musica.titulo %>">
            <div class="track-overlay">
              <% if (musica.link) { %>
                <a href="<%= musica.link %>" class="track-play-btn" title="Reproduzir" target="_blank">
              <% } else { %>
                <button class="track-play-btn" title="Reproduzir">
              <% } %>
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              <% if (musica.link) { %>
                </a>
                <a href="/download/<%= musica.id %>" class="track-download-btn" title="Download">
              <% } else { %>
                </button>
                <button class="track-download-btn" title="Download">
              <% } %>
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                </svg>
              <% if (musica.link) { %>
                </a>
              <% } else { %>
                </button>
              <% } %>
            </div>
            <div class="track-category-badge"><%= musica.categoria %></div>
          </div>
          
          <div class="track-details">
            <div class="track-main-info">
              <a href="#" class="track-artist-link"><%= musica.artista %></a>
              <h3 class="track-title-main"><%= musica.titulo %></h3>
              <p class="track-year"><%= musica.ano || new Date().getFullYear() %></p>
            </div>
            
            <div class="track-meta">
              <div class="track-stats">
                <span class="track-duration">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                  <%= musica.duracao %>
                </span>
                <span class="track-plays">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <span class="play-count"><%= musica.plays || 0 %></span>
                </span>
              </div>
              
              <div class="track-actions">
                <button class="action-btn-small like-btn" data-music-id="<%= musica.id %>" title="Curtir música">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                  </svg>
                  <span class="like-count"><%= musica.likes || 0 %></span>
                </button>
                <button class="action-btn-small" title="Compartilhar">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.50-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/>
                  </svg>
                </button>
                <button class="action-btn-small" title="Mais opções">
                  <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    
    <div class="popular-section-footer">
      <a href="/categorias" class="btn btn-secondary btn-large">Ver todas as categorias</a>
    </div>
  </div>
</section>

<!-- Modal de Login -->
<div id="loginModal" class="modal-overlay" style="display: none;">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Login Necessário</h3>
      <button class="modal-close" onclick="closeLoginModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p id="loginMessage">Para continuar, precisa fazer login na sua conta VIB Music.</p>
      <div class="login-actions">
        <button class="btn btn-primary" onclick="alert('Funcionalidade de login será implementada em breve!')">Fazer Login</button>
        <button class="btn btn-secondary" onclick="closeLoginModal()">Cancelar</button>
      </div>
    </div>
  </div>
</div>

<script>
// Sistema de curtidas
document.querySelectorAll('.like-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const musicId = this.dataset.musicId;
    
    try {
      const response = await fetch(`/like/${musicId}`, { method: 'POST' });
      const data = await response.json();
      
      if (data.needLogin) {
        showLoginModal(data.message);
      } else if (data.success) {
        // Atualizar contador de likes na interface
        const likeCount = this.querySelector('.like-count');
        likeCount.textContent = parseInt(likeCount.textContent) + 1;
        this.classList.add('liked');
      }
    } catch (error) {
      console.error('Erro ao curtir música:', error);
    }
  });
});

// Sistema de seguir artista
document.querySelectorAll('.follow-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const artist = this.dataset.artist;
    
    try {
      const response = await fetch(`/follow/${encodeURIComponent(artist)}`, { method: 'POST' });
      const data = await response.json();
      
      if (data.needLogin) {
        showLoginModal(data.message);
      } else if (data.success) {
        this.textContent = 'Seguindo';
        this.classList.add('following');
      }
    } catch (error) {
      console.error('Erro ao seguir artista:', error);
    }
  });
});

// Registrar plays quando clicar em reproduzir
document.querySelectorAll('.track-play-btn').forEach(btn => {
  if (btn.tagName === 'A') {
    btn.addEventListener('click', async function() {
      const musicId = this.closest('.popular-track-card').querySelector('.like-btn')?.dataset.musicId;
      if (musicId) {
        try {
          await fetch(`/play/${musicId}`, { method: 'POST' });
        } catch (error) {
          console.error('Erro ao registrar play:', error);
        }
      }
    });
  }
});

// Funções do modal
function showLoginModal(message) {
  document.getElementById('loginMessage').textContent = message;
  document.getElementById('loginModal').style.display = 'flex';
}

function closeLoginModal() {
  document.getElementById('loginModal').style.display = 'none';
}

// Fechar modal clicando fora
document.getElementById('loginModal').addEventListener('click', function(e) {
  if (e.target === this) {
    closeLoginModal();
  }
});
</script>