<!-- Artist Profile Page -->
<section class="artist-hero" style="background: linear-gradient(135deg, <%= artista.cor || '#8b5cf6' %>22, <%= artista.cor || '#8b5cf6' %>44), url('<%= artista.imagemCover || '/assets/imagens/imagens_hme/bela-foto-de-um-show-ao-vivo-com-um-show-de-luzes-amarelas-e-uma-grande-multidao-torcendo_181624-55905.jpg' %>'); background-size: cover; background-position: center;">
  <div class="container">
    <div class="artist-hero-content">
      <div class="artist-hero-info">
        <div class="artist-hero-image">
          <img src="<%= artista.imagem || '/assets/imagens/imagens_artistas/default.jpg' %>" alt="<%= artista.nome %>">
        </div>
        <div class="artist-hero-details">
          <div class="artist-breadcrumb">
            <a href="/">Início</a>
            <span class="breadcrumb-separator">›</span>
            <a href="/categorias">Artistas</a>
            <span class="breadcrumb-separator">›</span>
            <span class="current-artist"><%= artista.nome %></span>
          </div>
          <h1 class="artist-hero-name"><%= artista.nome %></h1>
          <p class="artist-hero-category"><%= artista.categoria %></p>
          <p class="artist-hero-bio"><%= artista.biografia %></p>
          
          <div class="artist-hero-stats">
            <div class="stat-item">
              <span class="stat-number"><%= artista.totalMusicas %></span>
              <span class="stat-label">Músicas</span>
            </div>
            <div class="stat-item">
              <span class="stat-number"><%= artista.seguidores || 0 %></span>
              <span class="stat-label">Seguidores</span>
            </div>
            <div class="stat-item">
              <span class="stat-number"><%= artista.totalPlays %></span>
              <span class="stat-label">Reproduções</span>
            </div>
          </div>
          
          <div class="artist-hero-actions">
            <button id="playAllArtistBtn" class="btn btn-primary btn-large" data-artist="<%= artista.nome %>">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              <span class="btn-text">Reproduzir Tudo</span>
            </button>
            <button id="followArtistBtn" class="btn btn-secondary btn-large" data-artist="<%= artista.nome %>">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              <span class="btn-text">Seguir</span>
            </button>
            <button class="btn btn-ghost btn-large">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
              </svg>
              Mais
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Artist Music Section -->
<section class="artist-music">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Músicas de <%= artista.nome %></h2>
      <div class="section-filters">
        <button class="filter-btn active" data-filter="all">Todas</button>
        <button class="filter-btn" data-filter="popular">Populares</button>
        <button class="filter-btn" data-filter="recent">Recentes</button>
      </div>
    </div>
    
    <div class="tracks-list">
      <% if (artista.musicas.length > 0) { %>
        <% artista.musicas.forEach((musica, index) => { %>
          <div class="track-row" data-music-id="<%= musica.id %>">
            <div class="track-number">
              <span class="number"><%= index + 1 %></span>
              <% if (musica.link) { %>
                <a href="<%= musica.link %>" class="play-btn" title="Reproduzir" target="_blank">
                  <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </a>
                <a href="/download/<%= musica.id %>" class="download-btn" title="Download">
                  <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                  </svg>
                </a>
              <% } else { %>
                <button class="play-btn" title="Reproduzir">
                  <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
                <button class="download-btn" title="Download">
                  <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                  </svg>
                </button>
              <% } %>
            </div>
            <div class="track-cover">
              <img src="<%= musica.cover || '/assets/images/default-cover.jpg' %>" alt="<%= musica.titulo || musica.nome %>" class="cover-image">
            </div>
            <div class="track-info">
              <h4 class="track-title"><%= musica.titulo || musica.nome %></h4>
              <p class="track-artist"><%= musica.artista %></p>
              <% if (musica.album) { %>
                <p class="track-album"><%= musica.album %></p>
              <% } %>
            </div>
            <div class="track-duration"><%= musica.duracao || '3:30' %></div>
            <div class="track-stats">
              <span class="track-plays"><%= musica.plays || 0 %> plays</span>
            </div>
            <div class="track-actions">
              <button class="action-btn like-btn" data-music-id="<%= musica.id %>" title="Curtir música">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                <span class="like-count"><%= musica.likes || 0 %></span>
              </button>
              <button class="action-btn" title="Mais opções">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                </svg>
              </button>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="no-music">
          <div class="no-music-icon">
            <svg width="64" height="64" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
            </svg>
          </div>
          <h3>Nenhuma música encontrada</h3>
          <p>Este artista ainda não tem músicas cadastradas.</p>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- Artist Albums Section -->
<% if (artista.albums && artista.albums.length > 0) { %>
<section class="artist-albums">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Álbuns</h2>
      <a href="#" class="view-all-link">Ver todos</a>
    </div>
    
    <div class="albums-grid">
      <% artista.albums.forEach(album => { %>
        <div class="album-card">
          <div class="album-cover">
            <img src="<%= album.cover %>" alt="<%= album.nome %>">
            <div class="album-overlay">
              <button class="album-play-btn">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="album-info">
            <h3 class="album-name"><%= album.nome %></h3>
            <p class="album-year"><%= album.ano %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Player de Música Interno -->
<div id="musicPlayer" class="music-player hidden">
  <div class="player-container">
    <div class="player-info">
      <div class="player-cover">
        <img id="playerCoverImg" src="" alt="Capa da música">
      </div>
      <div class="player-track-info">
        <h4 id="playerTrackTitle">Nome da Música</h4>
        <p id="playerArtistName">Nome do Artista</p>
      </div>
    </div>
    
    <div class="player-controls">
      <button id="prevBtn" class="player-btn">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
        </svg>
      </button>
      <button id="playPauseBtn" class="player-btn player-btn-main">
        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </button>
      <button id="nextBtn" class="player-btn">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
        </svg>
      </button>
    </div>
    
    <div class="player-progress">
      <div class="time-display">
        <span id="currentTime">0:00</span>
        <div class="progress-bar">
          <div id="progressFill" class="progress-fill"></div>
          <input type="range" id="progressSlider" min="0" max="100" value="0" class="progress-slider">
        </div>
        <span id="totalTime">0:00</span>
      </div>
    </div>
    
    <button id="closePlayerBtn" class="close-player-btn">
      <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
      </svg>
    </button>
  </div>
  
  <audio id="audioElement" preload="metadata"></audio>
</div>

