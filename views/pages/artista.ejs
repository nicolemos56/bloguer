// Função para tentar seguir artista
async function tentarSeguirArtista(artist, btnElement) {
  const btnText = btnElement.querySelector('.btn-text');
  
  try {
    const token = localStorage.getItem('vibToken');
    const response = await fetch(`/follow/${encodeURIComponent(artist)}`, { 
      method: 'POST',
      headers: {
        'Authorization': token,
        'Content-Type': 'application/json'
      }
    });
    
    const data = await response.json();
    
    if (data.needLogin) {
      // Armazenar ação para executar após login
      acaoPendente = {
        tipo: 'seguir',
        artist: artist,
        elemento: btnElement
      };
      showLoginModal(data.message);
    } else if (data.success) {
      // Atualizar interface baseado no estado
      if (data.following) {
        btnText.textContent = 'Seguindo';
        btnElement.classList.add('following');
        btnElement.classList.remove('btn-secondary');
        btnElement.classList.add('btn-accent');
      } else {
        btnText.textContent = 'Seguir';
        btnElement.classList.remove('following');
        btnElement.classList.remove('btn-accent');
        btnElement.classList.add('btn-secondary');
      }
    } else {
      alert(data.message || 'Erro ao processar solicitação');
    }
  } catch (error) {
    console.error('Erro ao seguir artista:', error);
    alert('Erro ao processar solicitação. Tente novamente.');
  }
}

