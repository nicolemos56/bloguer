<!-- Divulgar Section -->
<section class="divulgar-section">
  <div class="container">
    <div class="divulgar-content">
      <div class="divulgar-image">
        <img src="/assets/imagens/imagen_categorias/ouvindo_musica.png" alt="Divulgar Música">
      </div>
      
      <div class="divulgar-form">
        <div class="form-header">
          <h1>Bem-vindo/a</h1>
          <p>Divulgue a tua música hoje e vê-la a tocar</p>
          <button class="btn btn-primary btn-large" id="startDivulgacao" style="margin: 20px 0;">
            🎵 Escolher Plano de Divulgação
          </button>
        </div>
        
        <form class="submission-form" id="divulgarForm" action="#" method="POST" style="display: none;">
          <div class="form-group">
            <label for="artistName">Nome artístico</label>
            <input type="text" id="artistName" name="artistName" placeholder="Seu nome artístico" required>
          </div>
          
          <div class="form-group">
            <label for="songTitle">Título da Música</label>
            <input type="text" id="songTitle" name="songTitle" placeholder="Título da música" required>
          </div>
          
          <div class="form-group">
            <label for="releaseDate">Data de lançamento</label>
            <input type="date" id="releaseDate" name="releaseDate" required>
          </div>
          
          <div class="form-group">
            <label for="phone">Número de telefone</label>
            <input type="tel" id="phone" name="phone" placeholder="+244" required>
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="exemplo@email.com" required>
          </div>
          
          <div class="form-group">
            <label for="coverPhoto">Foto de capa</label>
            <input type="file" id="coverPhoto" name="coverPhoto" accept="image/*" required>
          </div>
          
          <div class="form-group">
            <label for="musicFile">Upload da música</label>
            <input type="file" id="musicFile" name="musicFile" accept="audio/*" required>
          </div>
          
          <div class="form-group">
            <label for="genre">Género musical</label>
            <select id="genre" name="genre" required>
              <option value="">Selecione o seu género musical</option>
              <option value="kuduro">Kuduro</option>
              <option value="rap">Rap</option>
              <option value="afrohouse">Afro House</option>
              <option value="semba">Semba</option>
              <option value="kizomba">Kizomba</option>
              <option value="gheto-zouk">Gheto Zouk</option>
            </select>
          </div>

          <div class="form-group">
            <label for="biography">Biografia do Artista</label>
            <textarea id="biography" name="biography" placeholder="Conte-nos sobre você, sua carreira musical, influências..." rows="4" required></textarea>
          </div>
          
          <button type="submit" class="btn btn-primary btn-full">Enviar</button>
        </form>

      </div>
    </div>
  </div>
</section>

<!-- Modal de Planos de Divulgação -->
<div id="planosModal" class="modal-overlay" style="display: none;">
  <div class="modal-content planos-modal">
    <div class="modal-header">
      <h2>Escolha seu Plano de Divulgação</h2>
      <button class="modal-close" onclick="closePlanosModal()">&times;</button>
    </div>
    <div class="modal-body">
      <div class="planos-grid">
        
        <!-- Plano Básico -->
        <div class="plano-card" onclick="selectPlano('basico')">
          <div class="plano-header">
            <h3>Básico</h3>
            <div class="plano-price">1.000 Kz</div>
          </div>
          <div class="plano-features">
            <div class="feature">✅ 1 música</div>
            <div class="feature">📈 Divulgação básica</div>
            <div class="feature">🎯 Alcance limitado</div>
          </div>
          <button class="btn btn-outline">Escolher Básico</button>
        </div>

        <!-- Plano Normal -->
        <div class="plano-card" onclick="selectPlano('normal')">
          <div class="plano-header">
            <h3>Normal</h3>
            <div class="plano-price">4.000 Kz</div>
          </div>
          <div class="plano-features">
            <div class="feature">✅ 5 músicas</div>
            <div class="feature">📈 Divulgação ampliada</div>
            <div class="feature">🎯 Melhor alcance</div>
            <div class="feature">📊 Estatísticas básicas</div>
          </div>
          <button class="btn btn-outline">Escolher Normal</button>
        </div>

        <!-- Plano Premium -->
        <div class="plano-card popular" onclick="selectPlano('premium')">
          <div class="plano-badge">Mais Popular</div>
          <div class="plano-header">
            <h3>Premium</h3>
            <div class="plano-price">15.000 Kz</div>
          </div>
          <div class="plano-features">
            <div class="feature">✅ EP completo</div>
            <div class="feature">📈 Engajamentos avançados</div>
            <div class="feature">👤 Criar perfil de artista</div>
            <div class="feature">📊 Relatórios detalhados</div>
            <div class="feature">🎯 Alcance premium</div>
          </div>
          <button class="btn btn-primary">Escolher Premium</button>
        </div>

        <!-- Plano Profissional -->
        <div class="plano-card" onclick="selectPlano('profissional')">
          <div class="plano-header">
            <h3>Profissional</h3>
            <div class="plano-price">30.000 Kz</div>
          </div>
          <div class="plano-features">
            <div class="feature">✅ Album completo</div>
            <div class="feature">📈 Engajamentos máximos</div>
            <div class="feature">👤 Perfil destacado</div>
            <div class="feature">⭐ Seção destaques</div>
            <div class="feature">📺 Publicidades/Anúncios</div>
            <div class="feature">🚀 Máximo alcance</div>
          </div>
          <button class="btn btn-primary">Escolher Profissional</button>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Payment Modal -->
<div class="payment-modal" id="paymentModal">
  <div class="payment-modal-content">
    <div class="payment-header">
      <h2>Finalizar Divulgação</h2>
      <p>Para finalizar o processo de divulgação, efetue o pagamento e envie o comprovante</p>
    </div>

    <div class="payment-details">
      <h3>Dados Bancários</h3>
      <div class="bank-info">
        <div class="bank-item">
          <span class="bank-label">Banco:</span>
          <span class="bank-value">BAI - Banco Angolano de Investimentos</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">Conta:</span>
          <span class="bank-value">40.10.80.001234567.89</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">IBAN:</span>
          <span class="bank-value">AO06 0040 1080 0012 3456 7890</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">Titular:</span>
          <span class="bank-value">e Nessa Banda Mekié, Lda</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">Valor:</span>
          <span class="bank-value" id="planValue">15.000 AOA</span>
        </div>
      </div>
    </div>

    <form class="payment-form" id="paymentForm" action="#" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="paymentReceipt">Comprovante de Pagamento</label>
        <input type="file" id="paymentReceipt" name="paymentReceipt" accept=".pdf" required>
        <small style="color: var(--text-muted); font-size: 1.4rem;">
          Envie o comprovante apenas em formato PDF (máx. 10MB)
        </small>
      </div>
      
      <div class="payment-actions">
        <button type="button" class="btn btn-secondary" id="cancelPayment">Cancelar</button>
        <button type="submit" class="btn btn-primary">Enviar Comprovante</button>
      </div>
    </form>
  </div>
</div>

<script>
let selectedPlan = null;

document.addEventListener('DOMContentLoaded', function() {
  const startButton = document.getElementById('startDivulgacao');
  const planosModal = document.getElementById('planosModal');
  const divulgarForm = document.getElementById('divulgarForm');
  const paymentModal = document.getElementById('paymentModal');
  const paymentForm = document.getElementById('paymentForm');
  const cancelButton = document.getElementById('cancelPayment');

  // Abrir modal de planos ao clicar em "Escolher Plano"
  startButton.addEventListener('click', function() {
    planosModal.style.display = 'flex';
  });

  divulgarForm.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const submitButton = divulgarForm.querySelector('button[type="submit"]');
    const originalText = submitButton.textContent;
    
    submitButton.textContent = 'Enviando...';
    submitButton.disabled = true;
    
    // Preparar dados do formulário
    const formData = new FormData(divulgarForm);
    
    // Enviar dados para o servidor
    fetch('/api/divulgacao', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        submitButton.textContent = 'Enviado ✓';
        submitButton.style.backgroundColor = '#28a745';
        
        // Armazenar ID do pedido para usar no comprovante
        sessionStorage.setItem('pedidoId', data.pedidoId);
        
        // Show payment modal
        setTimeout(() => {
          paymentModal.classList.add('show');
          document.body.style.overflow = 'hidden'; // Prevent background scroll
        }, 1000);
      } else {
        alert('Erro: ' + data.message);
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    })
    .catch(error => {
      console.error('Erro:', error);
      alert('Erro ao enviar formulário. Tente novamente.');
      submitButton.textContent = originalText;
      submitButton.disabled = false;
    });
  });

  // Close modal on cancel button
  cancelButton.addEventListener('click', function() {
    paymentModal.classList.remove('show');
    document.body.style.overflow = ''; // Restore scroll
    
    // Reset form button
    const divulgarSubmit = divulgarForm.querySelector('button[type="submit"]');
    divulgarSubmit.textContent = 'Enviar';
    divulgarSubmit.disabled = false;
    divulgarSubmit.style.backgroundColor = '';
  });

  // Close modal on backdrop click
  paymentModal.addEventListener('click', function(e) {
    if (e.target === paymentModal) {
      cancelButton.click();
    }
  });

  paymentForm.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const submitButton = paymentForm.querySelector('button[type="submit"]');
    const originalText = submitButton.textContent;
    
    submitButton.textContent = 'Processando...';
    submitButton.disabled = true;
    
    // Preparar dados do comprovante
    const formData = new FormData(paymentForm);
    const pedidoId = sessionStorage.getItem('pedidoId');
    
    if (!pedidoId) {
      alert('Erro: ID do pedido não encontrado');
      submitButton.textContent = originalText;
      submitButton.disabled = false;
      return;
    }
    
    formData.append('pedidoId', pedidoId);
    
    // Enviar comprovante para o servidor
    fetch('/api/comprovante-pagamento', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        submitButton.textContent = 'Comprovante Enviado ✓';
        submitButton.style.backgroundColor = '#28a745';
        
        setTimeout(() => {
          alert('Pedido de divulgação enviado com sucesso! Entraremos em contacto em breve.');
          
          // Reset forms
          divulgarForm.reset();
          paymentForm.reset();
          paymentModal.classList.remove('show');
          document.body.style.overflow = ''; // Restore scroll
          sessionStorage.removeItem('pedidoId');
          
          // Reset buttons
          const divulgarSubmit = divulgarForm.querySelector('button[type="submit"]');
          divulgarSubmit.textContent = 'Enviar';
          divulgarSubmit.disabled = false;
          divulgarSubmit.style.backgroundColor = '';
          
          submitButton.textContent = 'Enviar Comprovante';
          submitButton.disabled = false;
          submitButton.style.backgroundColor = '';
          
        }, 2000);
      } else {
        alert('Erro: ' + data.message);
        submitButton.textContent = originalText;
        submitButton.disabled = false;
      }
    })
    .catch(error => {
      console.error('Erro:', error);
      alert('Erro ao enviar comprovante. Tente novamente.');
      submitButton.textContent = originalText;
      submitButton.disabled = false;
    });
  });

  // Funções para controlar modais de planos
  window.selectPlano = function(plano) {
    selectedPlan = plano;
    
    // Atualizar valor no modal de pagamento conforme o plano
    const planValue = document.getElementById('planValue');
    const planValues = {
      'basico': '1.000 AOA',
      'normal': '4.000 AOA', 
      'premium': '15.000 AOA',
      'profissional': '30.000 AOA'
    };
    
    planValue.textContent = planValues[plano];
    
    // Fechar modal de planos e mostrar formulário
    planosModal.style.display = 'none';
    divulgarForm.style.display = 'block';
    
    // Scroll para o formulário
    divulgarForm.scrollIntoView({ behavior: 'smooth', block: 'start' });
    
    alert(`Plano ${plano} selecionado! Preencha o formulário abaixo.`);
  };

  window.closePlanosModal = function() {
    planosModal.style.display = 'none';
  };

  // Fechar modal ao clicar fora
  planosModal.addEventListener('click', function(e) {
    if (e.target === planosModal) {
      closePlanosModal();
    }
  });

});
</script>