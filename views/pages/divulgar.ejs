<!-- Divulgar Section -->
<section class="divulgar-section">
  <div class="container">
    <div class="divulgar-content">
      <div class="divulgar-image">
        <img src="/assets/imagens/imagen_categorias/ouvindo_musica.png" alt="Divulgar Música">
      </div>
      
      <div class="divulgar-form">
        <div class="form-header">
          <h1>Bem-vindo/a</h1>
          <p>Divulgue a tua música hoje e vê-la a tocar</p>
        </div>
        
        <form class="submission-form" id="divulgarForm" action="#" method="POST">
          <div class="form-group">
            <label for="artistName">Nome artístico</label>
            <input type="text" id="artistName" name="artistName" placeholder="Seu nome artístico" required>
          </div>
          
          <div class="form-group">
            <label for="songTitle">Título da Música</label>
            <input type="text" id="songTitle" name="songTitle" placeholder="Título da música" required>
          </div>
          
          <div class="form-group">
            <label for="releaseDate">Data de lançamento</label>
            <input type="date" id="releaseDate" name="releaseDate" required>
          </div>
          
          <div class="form-group">
            <label for="phone">Número de telefone</label>
            <input type="tel" id="phone" name="phone" placeholder="+244" required>
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="exemplo@email.com" required>
          </div>
          
          <div class="form-group">
            <label for="coverPhoto">Foto de capa</label>
            <input type="file" id="coverPhoto" name="coverPhoto" accept="image/*" required>
          </div>
          
          <div class="form-group">
            <label for="musicFile">Upload da música</label>
            <input type="file" id="musicFile" name="musicFile" accept="audio/*" required>
          </div>
          
          <div class="form-group">
            <label for="genre">Género musical</label>
            <select id="genre" name="genre" required>
              <option value="">Selecione o seu género musical</option>
              <option value="kuduro">Kuduro</option>
              <option value="rap">Rap</option>
              <option value="afrohouse">Afro House</option>
              <option value="semba">Semba</option>
              <option value="kizomba">Kizomba</option>
              <option value="gheto-zouk">Gheto Zouk</option>
            </select>
          </div>

          <div class="form-group">
            <label for="biography">Biografia do Artista</label>
            <textarea id="biography" name="biography" placeholder="Conte-nos sobre você, sua carreira musical, influências..." rows="4" required></textarea>
          </div>
          
          <button type="submit" class="btn btn-primary btn-full">Enviar</button>
        </form>

      </div>
    </div>
  </div>
</section>

<!-- Payment Modal -->
<div class="payment-modal" id="paymentModal">
  <div class="payment-modal-content">
    <div class="payment-header">
      <h2>Finalizar Divulgação</h2>
      <p>Para finalizar o processo de divulgação, efetue o pagamento e envie o comprovante</p>
    </div>

    <div class="payment-details">
      <h3>Dados Bancários</h3>
      <div class="bank-info">
        <div class="bank-item">
          <span class="bank-label">Banco:</span>
          <span class="bank-value">BAI - Banco Angolano de Investimentos</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">Conta:</span>
          <span class="bank-value">40.10.80.001234567.89</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">IBAN:</span>
          <span class="bank-value">AO06 0040 1080 0012 3456 7890</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">Titular:</span>
          <span class="bank-value">e Nessa Banda Mekié, Lda</span>
        </div>
        <div class="bank-item">
          <span class="bank-label">Valor:</span>
          <span class="bank-value">15.000 AOA</span>
        </div>
      </div>
    </div>

    <form class="payment-form" id="paymentForm" action="#" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label for="paymentReceipt">Comprovante de Pagamento</label>
        <input type="file" id="paymentReceipt" name="paymentReceipt" accept="image/*,.pdf" required>
        <small style="color: var(--text-muted); font-size: 1.4rem;">
          Faça upload da foto ou documento do comprovante de transferência
        </small>
      </div>
      
      <div class="payment-actions">
        <button type="button" class="btn btn-secondary" id="cancelPayment">Cancelar</button>
        <button type="submit" class="btn btn-primary">Enviar Comprovante</button>
      </div>
    </form>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const divulgarForm = document.getElementById('divulgarForm');
  const paymentModal = document.getElementById('paymentModal');
  const paymentForm = document.getElementById('paymentForm');
  const cancelButton = document.getElementById('cancelPayment');

  divulgarForm.addEventListener('submit', function(e) {
    e.preventDefault();
    
    // Simulate form submission
    const submitButton = divulgarForm.querySelector('button[type="submit"]');
    const originalText = submitButton.textContent;
    
    submitButton.textContent = 'Enviando...';
    submitButton.disabled = true;
    
    setTimeout(() => {
      submitButton.textContent = 'Enviado ✓';
      submitButton.style.backgroundColor = '#28a745';
      
      // Show payment modal
      setTimeout(() => {
        paymentModal.classList.add('show');
        document.body.style.overflow = 'hidden'; // Prevent background scroll
      }, 1000);
    }, 2000);
  });

  // Close modal on cancel button
  cancelButton.addEventListener('click', function() {
    paymentModal.classList.remove('show');
    document.body.style.overflow = ''; // Restore scroll
    
    // Reset form button
    const divulgarSubmit = divulgarForm.querySelector('button[type="submit"]');
    divulgarSubmit.textContent = 'Enviar';
    divulgarSubmit.disabled = false;
    divulgarSubmit.style.backgroundColor = '';
  });

  // Close modal on backdrop click
  paymentModal.addEventListener('click', function(e) {
    if (e.target === paymentModal) {
      cancelButton.click();
    }
  });

  paymentForm.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const submitButton = paymentForm.querySelector('button[type="submit"]');
    const originalText = submitButton.textContent;
    
    submitButton.textContent = 'Processando...';
    submitButton.disabled = true;
    
    setTimeout(() => {
      submitButton.textContent = 'Comprovante Enviado ✓';
      submitButton.style.backgroundColor = '#28a745';
      
      setTimeout(() => {
        alert('Pedido de divulgação enviado com sucesso! Entraremos em contacto em breve.');
        
        // Reset forms
        divulgarForm.reset();
        paymentForm.reset();
        paymentModal.classList.remove('show');
        document.body.style.overflow = ''; // Restore scroll
        
        // Reset buttons
        const divulgarSubmit = divulgarForm.querySelector('button[type="submit"]');
        divulgarSubmit.textContent = 'Enviar';
        divulgarSubmit.disabled = false;
        divulgarSubmit.style.backgroundColor = '';
        
        submitButton.textContent = 'Enviar Comprovante';
        submitButton.disabled = false;
        submitButton.style.backgroundColor = '';
        
      }, 2000);
    }, 2000);
  });
});
</script>