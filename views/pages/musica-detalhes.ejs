<!-- Página de Detalhes da Música -->
<div class="page-wrapper">
  <!-- Cabeçalho da Música -->
  <section class="music-details-hero">
    <div class="container-fluid">
      <div class="music-hero-content">
        <div class="music-cover-large">
          <img src="<%= musica.cover || '/assets/imagens/imagens_artistas/' + (musica.imagem || 'default.jpg') %>" alt="<%= musica.nome %>">
        </div>
        
        <div class="music-info">
          <div class="music-category-badge"><%= musica.categoria %></div>
          <h1 class="music-title"><%= musica.titulo || musica.nome %></h1>
          <h2 class="music-artist-name">
            <a href="/artista/<%= encodeURIComponent(musica.artista) %>"><%= musica.artista %></a>
          </h2>
          
          <div class="music-stats-line">
            <span class="music-year"><%= musica.ano || new Date().getFullYear() %></span>
            <span class="music-duration"><%= musica.duracao %></span>
            <span class="music-plays"><%= musica.plays || 0 %> reproduções</span>
            <span class="music-likes"><%= musica.likes || 0 %> curtidas</span>
          </div>
          
          <div class="music-actions-primary">
            <% if (musica.arquivo || musica.link) { %>
              <button class="btn btn-play-large" onclick="playMusic('<%= musica.id %>', '<%= musica.nome %>', '<%= musica.artista %>', '<%= musica.arquivo || musica.link %>', '<%= musica.cover || musica.imagem %>')">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                Reproduzir
              </button>
            <% } %>
            
            <a href="/download/<%= musica.id %>" class="btn btn-download-large">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
              </svg>
              Download
            </a>
            
            <button class="btn btn-like-large like-btn" data-music-id="<%= musica.id %>">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
              Curtir
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Informações da Música -->
  <section class="music-details-info">
    <div class="container-fluid">
      <div class="music-info-grid">
        <div class="music-description">
          <h3>Sobre esta música</h3>
          <div class="music-meta-info">
            <div class="meta-item">
              <strong>Artista:</strong> <%= musica.artista %>
            </div>
            <div class="meta-item">
              <strong>Categoria:</strong> <%= musica.categoria %>
            </div>
            <div class="meta-item">
              <strong>Ano:</strong> <%= musica.ano || new Date().getFullYear() %>
            </div>
            <% if (musica.duracao) { %>
              <div class="meta-item">
                <strong>Duração:</strong> <%= musica.duracao %>
              </div>
            <% } %>
            <% if (perfilArtista && perfilArtista.biografia) { %>
              <div class="meta-item">
                <strong>Biografia do Artista:</strong> 
                <p><%= perfilArtista.biografia %></p>
              </div>
            <% } %>
            <% if (perfilArtista && perfilArtista.seguidores !== undefined) { %>
              <div class="meta-item">
                <strong>Seguidores:</strong> <%= perfilArtista.seguidores %>
              </div>
            <% } %>
          </div>
        </div>
        
        <div class="music-sidebar-stats">
          <div class="stats-card">
            <h4>Estatísticas</h4>
            <div class="stat-item">
              <span class="stat-label">Reproduções</span>
              <span class="stat-value"><%= musica.plays || 0 %></span>
            </div>
            <div class="stat-item">
              <span class="stat-label">Curtidas</span>
              <span class="stat-value"><%= musica.likes || 0 %></span>
            </div>
            <div class="stat-item">
              <span class="stat-label">Downloads</span>
              <span class="stat-value"><%= musica.downloads || 0 %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mais Músicas do Artista -->
  <% if (musicasDoArtista && musicasDoArtista.length > 0) { %>
    <section class="related-music-section">
      <div class="container-fluid">
        <div class="section-header">
          <h2>Mais de <%= musica.artista %></h2>
        </div>
        
        <div class="related-music-grid">
          <% musicasDoArtista.forEach(musicaArtista => { %>
            <div class="related-music-card">
              <a href="/musica/<%= musicaArtista.id %>" class="card-link-wrapper">
                <div class="card-image">
                  <img src="<%= musicaArtista.cover || '/assets/imagens/imagens_artistas/' + (musicaArtista.imagem || 'default.jpg') %>" alt="<%= musicaArtista.titulo || musicaArtista.nome %>">
                  <div class="card-overlay">
                    <button class="card-play-btn" onclick="event.stopPropagation(); playMusic('<%= musicaArtista.id %>', '<%= musicaArtista.titulo || musicaArtista.nome %>', '<%= musicaArtista.artista %>', '<%= musicaArtista.arquivo || musicaArtista.link %>', '<%= musicaArtista.cover || musicaArtista.imagem %>')">
                      <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                  </div>
                </div>
                
                <div class="card-content">
                  <h3 class="card-title"><%= musicaArtista.titulo || musicaArtista.nome %></h3>
                  <p class="card-stats"><%= musicaArtista.plays || 0 %> plays</p>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- Músicas Relacionadas -->
  <% if (musicasRelacionadas && musicasRelacionadas.length > 0) { %>
    <section class="related-music-section">
      <div class="container-fluid">
        <div class="section-header">
          <h2>Mais <%= musica.categoria %></h2>
        </div>
        
        <div class="related-music-grid">
          <% musicasRelacionadas.forEach(musicaRelacionada => { %>
            <div class="related-music-card">
              <a href="/musica/<%= musicaRelacionada.id %>" class="card-link-wrapper">
                <div class="card-image">
                  <img src="<%= musicaRelacionada.cover || '/assets/imagens/imagens_artistas/' + (musicaRelacionada.imagem || 'default.jpg') %>" alt="<%= musicaRelacionada.titulo || musicaRelacionada.nome %>">
                  <div class="card-overlay">
                    <button class="card-play-btn" onclick="event.stopPropagation(); playMusic('<%= musicaRelacionada.id %>', '<%= musicaRelacionada.titulo || musicaRelacionada.nome %>', '<%= musicaRelacionada.artista %>', '<%= musicaRelacionada.arquivo || musicaRelacionada.link %>', '<%= musicaRelacionada.cover || musicaRelacionada.imagem %>')">
                      <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                  </div>
                </div>
                
                <div class="card-content">
                  <h3 class="card-title"><%= musicaRelacionada.titulo || musicaRelacionada.nome %></h3>
                  <p class="card-artist"><%= musicaRelacionada.artista %></p>
                  <p class="card-stats"><%= musicaRelacionada.plays || 0 %> plays</p>
                </div>
              </a>
            </div>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>
</div>

<!-- Player de Música Modal -->
<div id="musicPlayer" class="music-player-modal hidden">
  <div class="modal-backdrop"></div>
  <div class="player-modal-content">
    <div class="player-header">
      <h3 id="playerTrackTitle">Nome da Música</h3>
      <button id="closePlayerBtn" class="close-player-btn">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
        </svg>
      </button>
    </div>
    
    <div class="player-body">
      <div class="player-cover-section">
        <img id="playerCoverImg" src="" alt="Capa da música" class="player-cover-large">
      </div>
      
      <div class="player-controls-section">
        <div class="player-track-info">
          <h4 id="playerArtistName">Nome do Artista</h4>
          <p id="playerDuration">0:00</p>
        </div>
        
        <div class="player-controls">
          <button id="prevBtn" class="player-control-btn">
            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
            </svg>
          </button>
          
          <button id="playPauseBtn" class="player-control-btn play-pause-btn">
            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
          
          <button id="nextBtn" class="player-control-btn">
            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
            </svg>
          </button>
        </div>
        
        <div class="player-volume-section">
          <button id="volumeBtn" class="player-control-btn">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
              <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
            </svg>
          </button>
          <input type="range" id="volumeSlider" class="volume-slider" min="0" max="1" step="0.1" value="0.7">
        </div>
      </div>
    </div>
    
    <div class="player-progress">
      <div class="progress-bar">
        <div class="progress-fill" id="progressFill"></div>
        <input type="range" id="progressSlider" class="progress-slider" min="0" max="100" value="0">
      </div>
      <div class="progress-times">
        <span id="currentTime">0:00</span>
        <span id="totalTime">0:00</span>
      </div>
    </div>
  </div>
</div>

<audio id="audioPlayer" preload="metadata"></audio>