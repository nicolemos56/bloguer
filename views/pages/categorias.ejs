<!-- Categories Hero Section -->
<section class="categories-hero">
  <div class="container">
    <div class="categories-hero-content">
      <h1 class="hero-title">Categorias Musicais</h1>
      <p class="hero-description">Explore os diferentes géneros musicais e descubra novos artistas</p>
    </div>
  </div>
</section>

<!-- Categories Grid Section -->
<section class="categories-section">
  <div class="container">
    <div class="categories-grid">
      <% categorias.forEach(categoria => { %>
        <article class="category-card" data-category="<%= categoria.id %>">
          <div class="category-image-wrapper">
            <div class="category-image">
              <img src="/assets/imagens/imagen_categorias/<%= categoria.imagem %>" alt="<%= categoria.nome %>">
              <div class="category-overlay" style="background: linear-gradient(135deg, <%= categoria.cor %>66, <%= categoria.cor %>99);">
                <div class="category-icon">
                  <svg width="48" height="48" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
          
          <div class="category-info">
            <div class="category-header">
              <h2 class="category-name" style="color: <%= categoria.cor %>"><%= categoria.nome %></h2>
              <div class="category-badge" style="background-color: <%= categoria.cor %>;">Popular</div>
            </div>
            <p class="category-description"><%= categoria.descricao %></p>
            
            <div class="category-stats">
              <div class="stat-item">
                <span class="stat-number">24</span>
                <span class="stat-label">Artistas</span>
              </div>
              <div class="stat-item">
                <span class="stat-number">156</span>
                <span class="stat-label">Músicas</span>
              </div>
              <div class="stat-item">
                <span class="stat-number">2.1K</span>
                <span class="stat-label">Plays</span>
              </div>
            </div>
            
            <div class="category-actions">
              <a href="/categoria/<%= categoria.id %>" class="btn btn-primary">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                Explorar
              </a>
              <button class="btn btn-secondary category-favorite" data-category="<%= categoria.id %>">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                Favoritar
              </button>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Artists Section -->
<section class="featured-artists">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Artistas do mês</h2>
      <p class="section-subtitle">Os artistas em destaque desta plataforma</p>
    </div>
    
    <div class="artists-grid">
      <% (artistasDoMes || []).forEach(artista => { %>
        <article class="artist-card-detailed">
          <a href="/artista/<%= encodeURIComponent(artista.nome) %>" class="artist-card-link">
            <div class="artist-image">
              <img src="<%= artista.imagem || '/assets/imagens/imagens_artistas/default.jpg' %>" alt="<%= artista.nome %>">
              <div class="artist-overlay">
                <button class="artist-play-btn" style="background-color: var(--accent-primary)">
                  <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="artist-info">
              <h3 class="artist-name"><%= artista.nome %></h3>
              <p class="artist-stats"><%= artista.quantidadeMusicas || 0 %> músicas</p>
            </div>
          </a>
          <div class="artist-actions">
            <button class="btn btn-secondary btn-small follow-btn" data-artist="<%= artista.nome %>">Seguir</button>
            <a href="/artista/<%= encodeURIComponent(artista.nome) %>" class="btn btn-ghost btn-small">Ver perfil</a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<style>
/* Estilos para links dos cards de artistas */
.artist-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
  flex: 1;
}

.artist-card-link:hover {
  text-decoration: none;
  color: inherit;
}

.artist-card-detailed {
  display: flex;
  flex-direction: column;
}

.artist-actions {
  margin-top: auto;
  padding-top: 15px;
}

/* Modal de Login */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease-out;
}

.login-modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
}

.login-modal-content {
  background: #1a1a1a;
  border-radius: 12px;
  padding: 24px;
  max-width: 400px;
  width: 90%;
  position: relative;
  color: white;
  text-align: center;
  animation: slideUp 0.3s ease-out;
}

.login-modal-header {
  margin-bottom: 16px;
}

.login-modal-icon {
  color: #3b82f6;
  margin-bottom: 8px;
}

.login-modal-body {
  margin-bottom: 0;
}

.login-message {
  margin: 0 0 24px 0;
  font-size: 16px;
  line-height: 1.5;
  color: #e5e5e5;
  text-align: center;
}

.login-form {
  margin-bottom: 20px;
}

.login-input-group {
  margin-bottom: 16px;
}

.login-input-group input {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #374151;
  border-radius: 8px;
  background: #111827;
  color: white;
  font-size: 14px;
  transition: border-color 0.2s ease;
  box-sizing: border-box;
}

.login-input-group input:focus {
  outline: none;
  border-color: #3b82f6;
}

.login-input-group input::placeholder {
  color: #9ca3af;
}

.login-btn {
  width: 100%;
  background: var(--accent-primary, #3b82f6);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s ease;
  margin-bottom: 16px;
}

.login-btn:hover {
  background: #2563eb;
}

.login-links {
  display: flex;
  justify-content: space-between;
  gap: 16px;
}

.login-link {
  color: #3b82f6;
  text-decoration: none;
  font-size: 13px;
  transition: color 0.2s ease;
}

.login-link:hover {
  color: #60a5fa;
  text-decoration: underline;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { 
    transform: translateY(20px);
    opacity: 0;
  }
  to { 
    transform: translateY(0);
    opacity: 1;
  }
}
</style>

<script>
// Sistema de seguir artista na página de categorias
document.querySelectorAll('.follow-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const artist = this.dataset.artist;
    
    try {
      const response = await fetch(`/follow/${encodeURIComponent(artist)}`, { method: 'POST' });
      const data = await response.json();
      
      if (data.needLogin) {
        showLoginModal(data.message);
      } else if (data.success) {
        this.textContent = 'Seguindo';
        this.classList.add('following');
      }
    } catch (error) {
      console.error('Erro ao seguir artista:', error);
    }
  });
});

// Função para mostrar modal de login
function showLoginModal(message) {
  document.getElementById('loginModalMessage').textContent = message;
  document.getElementById('loginModal').style.display = 'flex';
}

// Função para fechar modal de login
function closeLoginModal() {
  document.getElementById('loginModal').style.display = 'none';
  if (document.getElementById('loginForm')) {
    document.getElementById('loginForm').reset();
  }
}

// Funções para modais
function showRegisterModal() {
  closeLoginModal();
  document.getElementById('registerModal').style.display = 'flex';
}

function showForgotModal() {
  closeLoginModal();
  alert('Funcionalidade de recuperação de senha será implementada em breve!');
}

function closeRegisterModal() {
  document.getElementById('registerModal').style.display = 'none';
  if (document.getElementById('registerForm')) {
    document.getElementById('registerForm').reset();
  }
}

function showLoginFromRegister() {
  closeRegisterModal();
  document.getElementById('loginModal').style.display = 'flex';
}

// Lidar com submissão dos formulários
document.addEventListener('DOMContentLoaded', function() {
  // Formulário de Login
  const loginForm = document.getElementById('loginForm');
  if (loginForm) {
    loginForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const email = document.getElementById('loginEmail').value;
      const password = document.getElementById('loginPassword').value;
      const submitBtn = this.querySelector('.login-btn');
      
      if (email && password) {
        // Mostrar loading
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Entrando...';
        submitBtn.disabled = true;
        
        try {
          const response = await fetch('/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email, password })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Salvar token na sessão
            localStorage.setItem('vibToken', data.token);
            localStorage.setItem('vibUser', JSON.stringify(data.usuario));
            
            // Mostrar sucesso
            alert(`Bem-vindo, ${data.usuario.nome}! Login realizado com sucesso.`);
            closeLoginModal();
            
            // Recarregar para atualizar interface
            window.location.reload();
          } else {
            // Mostrar erro
            alert(data.message || 'Erro no login. Tente novamente.');
          }
        } catch (error) {
          console.error('Erro ao fazer login:', error);
          alert('Erro de conexão. Tente novamente.');
        } finally {
          // Restaurar botão
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      }
    });
  }
  
  // Formulário de Cadastro
  const registerForm = document.getElementById('registerForm');
  if (registerForm) {
    registerForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const nome = document.getElementById('registerNome').value;
      const email = document.getElementById('registerEmail').value;
      const password = document.getElementById('registerPassword').value;
      const confirmPassword = document.getElementById('registerConfirmPassword').value;
      const submitBtn = this.querySelector('.login-btn');
      
      if (nome && email && password && confirmPassword) {
        // Mostrar loading
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Criando...';
        submitBtn.disabled = true;
        
        try {
          const response = await fetch('/register', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ nome, email, password, confirmPassword })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Salvar token na sessão (login automático)
            localStorage.setItem('vibToken', data.token);
            localStorage.setItem('vibUser', JSON.stringify(data.usuario));
            
            // Mostrar sucesso
            alert(`Bem-vindo, ${data.usuario.nome}! Sua conta foi criada com sucesso.`);
            closeRegisterModal();
            
            // Recarregar para atualizar interface
            window.location.reload();
          } else {
            // Mostrar erro
            alert(data.message || 'Erro no cadastro. Tente novamente.');
          }
        } catch (error) {
          console.error('Erro ao fazer cadastro:', error);
          alert('Erro de conexão. Tente novamente.');
        } finally {
          // Restaurar botão
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      }
    });
  }
});
</script>

<!-- Modal de Login -->
<div id="loginModal" class="login-modal" style="display: none;">
  <div class="login-modal-overlay" onclick="closeLoginModal()"></div>
  <div class="login-modal-content">
    <div class="login-modal-header">
      <div class="login-modal-icon">
        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1V3H9V1L3 7V9H21ZM21 19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V11H21V19Z"/>
        </svg>
      </div>
    </div>
    <div class="login-modal-body">
      <p id="loginModalMessage" class="login-message">Precisa fazer login para seguir artista!</p>
      
      <form id="loginForm" class="login-form">
        <div class="login-input-group">
          <input type="email" id="loginEmail" name="email" placeholder="Email ou usuário" required>
        </div>
        
        <div class="login-input-group">
          <input type="password" id="loginPassword" name="password" placeholder="Senha" required>
        </div>
        
        <button type="submit" class="login-btn">Entrar</button>
      </form>
      
      <div class="login-links">
        <a href="#" onclick="showRegisterModal()" class="login-link">Cadastrar-se</a>
        <a href="#" onclick="showForgotModal()" class="login-link">Esqueci minha senha</a>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Cadastro -->
<div id="registerModal" class="login-modal" style="display: none;">
  <div class="login-modal-overlay" onclick="closeRegisterModal()"></div>
  <div class="login-modal-content">
    <div class="login-modal-header">
      <div class="login-modal-icon">
        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1V3H9V1L3 7V9H21ZM21 19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V11H21V19Z"/>
        </svg>
      </div>
    </div>
    <div class="login-modal-body">
      <p class="login-message">Criar sua conta VIB MUSIC</p>
      
      <form id="registerForm" class="login-form">
        <div class="login-input-group">
          <input type="text" id="registerNome" name="nome" placeholder="Nome completo" required>
        </div>
        
        <div class="login-input-group">
          <input type="email" id="registerEmail" name="email" placeholder="Email" required>
        </div>
        
        <div class="login-input-group">
          <input type="password" id="registerPassword" name="password" placeholder="Senha (mín. 6 caracteres)" required>
        </div>
        
        <div class="login-input-group">
          <input type="password" id="registerConfirmPassword" name="confirmPassword" placeholder="Confirmar senha" required>
        </div>
        
        <button type="submit" class="login-btn">Criar Conta</button>
      </form>
      
      <div class="login-links">
        <a href="#" onclick="showLoginFromRegister()" class="login-link">Já tem conta? Fazer login</a>
      </div>
    </div>
  </div>
</div>