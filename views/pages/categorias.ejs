<!-- Categories Hero Section -->
<section class="categories-hero">
  <div class="container">
    <div class="categories-hero-content">
      <h1 class="hero-title">Categorias Musicais</h1>
      <p class="hero-description">Explore os diferentes géneros musicais e descubra novos artistas</p>
    </div>
  </div>
</section>

<!-- Categories Grid Section -->
<section class="categories-section">
  <div class="container">
    <div class="categories-grid">
      <% categorias.forEach(categoria => { %>
        <article class="category-card" data-category="<%= categoria.id %>">
          <div class="category-image-wrapper">
            <div class="category-image">
              <img src="/assets/imagens/imagen_categorias/<%= categoria.imagem %>" alt="<%= categoria.nome %>">
              <div class="category-overlay" style="background: linear-gradient(135deg, <%= categoria.cor %>66, <%= categoria.cor %>99);">
                <button class="category-play-btn" data-category="<%= categoria.id %>" data-category-name="<%= categoria.nome %>" onclick="event.stopPropagation(); playAllCategory('<%= categoria.id %>', '<%= categoria.nome %>', this)">
                  <svg width="48" height="48" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          
          <div class="category-info">
            <div class="category-header">
              <h2 class="category-name" style="color: <%= categoria.cor %>"><%= categoria.nome %></h2>
              <div class="category-badge" style="background-color: <%= categoria.cor %>;">Popular</div>
            </div>
            <p class="category-description"><%= categoria.descricao %></p>
            
            <div class="category-stats">
              <div class="stat-item">
                <span class="stat-label">Artistas:</span>
                <span class="stat-number"><%= categoria.totalArtistas %></span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Músicas:</span>
                <span class="stat-number"><%= categoria.totalMusicas %></span>
              </div>
              <div class="stat-item">
                <span class="stat-label">Plays:</span>
                <span class="stat-number"><%= categoria.totalPlays >= 1000 ? (categoria.totalPlays / 1000).toFixed(1) + 'K' : categoria.totalPlays %></span>
              </div>
            </div>
            
            <div class="category-actions">
              <button class="btn btn-primary category-play-text-btn" data-category="<%= categoria.id %>" data-category-name="<%= categoria.nome %>" onclick="playAllCategory('<%= categoria.id %>', '<%= categoria.nome %>', this)">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                Reproduzir tudo
              </button>
              <a href="/categoria/<%= categoria.id %>" class="btn btn-secondary">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M21 12l-7-7v5H5a2 2 0 000 4h9v5l7-7z"/>
                </svg>
                Explorar
              </a>
              <button class="btn btn-secondary category-favorite" data-category="<%= categoria.id %>">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                </svg>
                Favoritar
              </button>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Artists Section -->
<section class="featured-artists">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Artistas do mês</h2>
      <p class="section-subtitle">Os artistas em destaque desta plataforma</p>
    </div>
    
    <div class="artists-grid">
      <% (artistasDoMes || []).forEach(artista => { %>
        <article class="artist-card-detailed">
          <a href="/artista/<%= encodeURIComponent(artista.nome) %>" class="artist-card-link">
            <div class="artist-image">
              <img src="<%= artista.imagem || '/assets/imagens/imagens_artistas/default.jpg' %>" alt="<%= artista.nome %>">
              <div class="artist-overlay">
                <button class="artist-play-btn" style="background-color: var(--accent-primary)">
                  <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="artist-info">
              <h3 class="artist-name"><%= artista.nome %></h3>
              <p class="artist-stats"><%= artista.quantidadeMusicas || 0 %> músicas</p>
            </div>
          </a>
          <div class="artist-actions">
            <button class="btn btn-secondary btn-small follow-btn" data-artist="<%= artista.nome %>">Seguir</button>
            <a href="/artista/<%= encodeURIComponent(artista.nome) %>" class="btn btn-ghost btn-small">Ver perfil</a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<style>
/* Estilos para links dos cards de artistas */
.artist-card-link {
  display: block;
  text-decoration: none;
  color: inherit;
  flex: 1;
}

.artist-card-link:hover {
  text-decoration: none;
  color: inherit;
}

.artist-card-detailed {
  display: flex;
  flex-direction: column;
}

.artist-actions {
  margin-top: auto;
  padding-top: 15px;
}

/* Modal de Login */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease-out;
}

.login-modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
}

.login-modal-content {
  background: #1a1a1a;
  border-radius: 12px;
  padding: 24px;
  max-width: 400px;
  width: 90%;
  position: relative;
  color: white;
  text-align: center;
  animation: slideUp 0.3s ease-out;
}

.login-modal-header {
  margin-bottom: 16px;
}

.login-modal-icon {
  color: #3b82f6;
  margin-bottom: 8px;
}

.login-modal-body {
  margin-bottom: 0;
}

.login-message {
  margin: 0 0 24px 0;
  font-size: 16px;
  line-height: 1.5;
  color: #e5e5e5;
  text-align: center;
}

.login-form {
  margin-bottom: 20px;
}

.login-input-group {
  margin-bottom: 16px;
}

.login-input-group input {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #374151;
  border-radius: 8px;
  background: #111827;
  color: white;
  font-size: 14px;
  transition: border-color 0.2s ease;
  box-sizing: border-box;
}

.login-input-group input:focus {
  outline: none;
  border-color: #3b82f6;
}

.login-input-group input::placeholder {
  color: #9ca3af;
}

.login-btn {
  width: 100%;
  background: var(--accent-primary, #3b82f6);
  color: white;
  border: none;
  border-radius: 8px;
  padding: 12px 24px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s ease;
  margin-bottom: 16px;
