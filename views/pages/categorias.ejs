<script>
// Variável global para armazenar ação pendente
let acaoPendente = null;

// Verificar estado do usuário quando página carrega
document.addEventListener('DOMContentLoaded', async function() {
  await verificarEstadoUsuario();
});

// Função para verificar e atualizar estado dos botões
async function verificarEstadoUsuario() {
  try {
    const token = localStorage.getItem('vibToken');
    if (!token) return; // Se não há token, usuário não está logado
    
    const response = await fetch('/user/state', {
      headers: {
        'Authorization': token
      }
    });
    
    const data = await response.json();
    
    if (data.loggedIn) {
      // Atualizar botões de seguir artistas
      if (data.artistasFavoritos && data.artistasFavoritos.length > 0) {
        const allArtistsResponse = await fetch('/api/artistas');
        if (allArtistsResponse.ok) {
          const allArtists = await allArtistsResponse.json();
          
          document.querySelectorAll('.follow-btn[data-artist]').forEach(btn => {
            const artistName = btn.dataset.artist;
            const foundArtist = allArtists.find(a => a.nome === artistName);
            
            if (foundArtist && data.artistasFavoritos.includes(foundArtist.id)) {
              btn.textContent = 'Seguindo';
              btn.classList.add('following');
            }
          });
        }
      }
    }
  } catch (error) {
    console.error('Erro ao verificar estado do usuário:', error);
  }
}

// Sistema de seguir artista na página de categorias
document.querySelectorAll('.follow-btn').forEach(btn => {
  btn.addEventListener('click', async function() {
    const artist = this.dataset.artist;
    await tentarSeguirArtista(artist, this);
  });
});

// Função para tentar seguir artista
async function tentarSeguirArtista(artist, btnElement) {
  try {
    const token = localStorage.getItem('vibToken');
    const response = await fetch(`/follow/${encodeURIComponent(artist)}`, { 
      method: 'POST',
      headers: {
        'Authorization': token,
        'Content-Type': 'application/json'
      }
    });
    
    const data = await response.json();
    
    if (data.needLogin) {
      // Armazenar ação para executar após login
      acaoPendente = {
        tipo: 'seguir',
        artist: artist,
        elemento: btnElement
      };
      showLoginModal(data.message);
    } else if (data.success) {
      // Atualizar interface baseado no estado
      if (data.following) {
        btnElement.textContent = 'Seguindo';
        btnElement.classList.add('following');
      } else {
        btnElement.textContent = 'Seguir';
        btnElement.classList.remove('following');
      }
    }
  } catch (error) {
    console.error('Erro ao seguir artista:', error);
  }
}

// Função para mostrar modal de login
function showLoginModal(message) {
  document.getElementById('loginModalMessage').textContent = message;
  document.getElementById('loginModal').style.display = 'flex';
}

// Função para fechar modal de login
function closeLoginModal() {
  document.getElementById('loginModal').style.display = 'none';
  if (document.getElementById('loginForm')) {
    document.getElementById('loginForm').reset();
  }
}

// Funções para modais
function showRegisterModal() {
  closeLoginModal();
  document.getElementById('registerModal').style.display = 'flex';
}

function showForgotModal() {
  closeLoginModal();
  alert('Funcionalidade de recuperação de senha será implementada em breve!');
}

function closeRegisterModal() {
  document.getElementById('registerModal').style.display = 'none';
  if (document.getElementById('registerForm')) {
    document.getElementById('registerForm').reset();
  }
}

function showLoginFromRegister() {
  closeRegisterModal();
  document.getElementById('loginModal').style.display = 'flex';
}

// Lidar com submissão dos formulários
document.addEventListener('DOMContentLoaded', function() {
  // Formulário de Login
  const loginForm = document.getElementById('loginForm');
  if (loginForm) {
    loginForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const email = document.getElementById('loginEmail').value;
      const password = document.getElementById('loginPassword').value;
      const submitBtn = this.querySelector('.login-btn');
      
      if (email && password) {
        // Mostrar loading
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Entrando...';
        submitBtn.disabled = true;
        
        try {
          const response = await fetch('/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ email, password })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Salvar token na sessão
            localStorage.setItem('vibToken', data.token);
            localStorage.setItem('vibUser', JSON.stringify(data.usuario));
            
            // Mostrar sucesso
            alert(`Bem-vindo, ${data.usuario.nome}! Login realizado com sucesso.`);
            closeLoginModal();
            
            // Recarregar para atualizar interface
            window.location.reload();
          } else {
            // Mostrar erro
            alert(data.message || 'Erro no login. Tente novamente.');
          }
        } catch (error) {
          console.error('Erro ao fazer login:', error);
          alert('Erro de conexão. Tente novamente.');
        } finally {
          // Restaurar botão
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      }
    });
  }
  
  // Formulário de Cadastro
  const registerForm = document.getElementById('registerForm');
  if (registerForm) {
    registerForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const nome = document.getElementById('registerNome').value;
      const email = document.getElementById('registerEmail').value;
      const password = document.getElementById('registerPassword').value;
      const confirmPassword = document.getElementById('registerConfirmPassword').value;
      const submitBtn = this.querySelector('.login-btn');
      
      if (nome && email && password && confirmPassword) {
        // Mostrar loading
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Criando...';
        submitBtn.disabled = true;
        
        try {
          const response = await fetch('/register', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ nome, email, password, confirmPassword })
          });
          
          const data = await response.json();
          
          if (data.success) {
            // Salvar token na sessão (login automático)
            localStorage.setItem('vibToken', data.token);
            localStorage.setItem('vibUser', JSON.stringify(data.usuario));
            
            // Mostrar sucesso
            alert(`Bem-vindo, ${data.usuario.nome}! Sua conta foi criada com sucesso.`);
            closeRegisterModal();
            
            // Recarregar para atualizar interface
            window.location.reload();
          } else {
            // Mostrar erro
            alert(data.message || 'Erro no cadastro. Tente novamente.');
          }
        } catch (error) {
          console.error('Erro ao fazer cadastro:', error);
          alert('Erro de conexão. Tente novamente.');
        } finally {
          // Restaurar botão
          submitBtn.textContent = originalText;
          submitBtn.disabled = false;
        }
      }
    });
  }
});

// Variáveis de controle do player de categoria
let currentlyPlayingCategoryButton = null;
let currentCategoryAudio = null;
let currentCategoryPlaylist = [];
let currentCategoryIndex = 0;

// Função para reproduzir todas as músicas de uma categoria
async function playAllCategory(categoryId, categoryName, buttonElement) {
  try {
    // Se o mesmo botão está tocando, pausar/resumir
    if (currentlyPlayingCategoryButton === buttonElement) {
      if (currentCategoryAudio && !currentCategoryAudio.paused) {
        currentCategoryAudio.pause();
        updateCategoryButtonState(buttonElement, false, 'Reproduzir tudo');
      } else if (currentCategoryAudio) {
        currentCategoryAudio.play();
        updateCategoryButtonState(buttonElement, true, 'Pausando...');
      }
      return;
    }

    // Parar música atual se houver
    if (currentCategoryAudio) {
      currentCategoryAudio.pause();
      currentCategoryAudio.currentTime = 0;
    }

    // Resetar todos os botões
    updateCategoryButtonState(null, false);

    // Mostrar feedback visual imediato
    updateCategoryButtonState(buttonElement, true, 'Carregando...');
    currentlyPlayingCategoryButton = buttonElement;

    // Buscar músicas da categoria
    console.log('Buscando músicas da categoria:', categoryId);
    const response = await fetch(`/api/categoria/${categoryId}/musicas`);
    
    if (!response.ok) {
      throw new Error('Erro ao buscar músicas da categoria');
    }

    const data = await response.json();
    
    if (!data.success || !data.musicas || data.musicas.length === 0) {
      alert('Nenhuma música encontrada nesta categoria');
      updateCategoryButtonState(buttonElement, false, 'Reproduzir tudo');
      currentlyPlayingCategoryButton = null;
      return;
    }

    currentCategoryPlaylist = data.musicas;
    currentCategoryIndex = 0;
    
    // Registrar reprodução da categoria no backend
    fetch(`/play-category/${categoryId}`, { method: 'POST' })
      .catch(error => console.error('Erro ao registrar reprodução da categoria:', error));

    // Iniciar reprodução
    playCurrentCategoryTrack(buttonElement, categoryName);

  } catch (error) {
    console.error('Erro ao reproduzir categoria:', error);
    alert('Erro ao carregar músicas da categoria');
    updateCategoryButtonState(buttonElement, false, 'Reproduzir tudo');
    currentlyPlayingCategoryButton = null;
  }
}

// Reproduzir música atual da playlist da categoria
function playCurrentCategoryTrack(buttonElement, categoryName) {
  if (currentCategoryIndex >= currentCategoryPlaylist.length) {
    // Playlist terminou
    updateCategoryButtonState(buttonElement, false, 'Reproduzir tudo');
    currentlyPlayingCategoryButton = null;
    currentCategoryAudio = null;
    return;
  }

  const track = currentCategoryPlaylist[currentCategoryIndex];
  
  // Verificar se a música tem arquivo de áudio
  if (!track.arquivo && !track.link) {
    console.log('Música sem arquivo, pulando:', track.titulo);
    currentCategoryIndex++;
    playCurrentCategoryTrack(buttonElement, categoryName);
    return;
  }

  const audioSrc = track.arquivo || track.link;
  
  // Registrar reprodução individual
  fetch(`/play/${track.id}`, { method: 'POST' })
    .catch(error => console.error('Erro ao registrar play:', error));

  currentCategoryAudio = new Audio(audioSrc);
  
  // Atualizar botão com nome da música atual
  updateCategoryButtonState(buttonElement, true, `♪ ${track.titulo}`);
  
  console.log(`Tocando: ${track.titulo} por ${track.artista}`);
  
  currentCategoryAudio.play().catch(error => {
    console.error('Erro ao reproduzir áudio:', error);
    // Pular para próxima música em caso de erro
    currentCategoryIndex++;
    playCurrentCategoryTrack(buttonElement, categoryName);
    return;
  });

  // Quando a música terminar, tocar a próxima
  currentCategoryAudio.addEventListener('ended', () => {
    currentCategoryIndex++;
    playCurrentCategoryTrack(buttonElement, categoryName);
  });

  // Em caso de erro no áudio, pular para próxima
  currentCategoryAudio.addEventListener('error', () => {
    console.error('Erro no áudio, pulando:', track.titulo);
    currentCategoryIndex++;
    playCurrentCategoryTrack(buttonElement, categoryName);
  });
}

// Função para atualizar estado visual dos botões da categoria
function updateCategoryButtonState(button, isPlaying, customText = null) {
  // Se button é null, resetar todos os botões
  if (!button) {
    document.querySelectorAll('.category-play-btn, .category-play-text-btn').forEach(btn => {
      btn.classList.remove('playing');
      const svg = btn.querySelector('svg path');
      if (svg) svg.setAttribute('d', 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z');
      
      // Restaurar texto original se for botão de texto
      if (btn.classList.contains('category-play-text-btn')) {
        btn.innerHTML = `<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        Reproduzir tudo`;
      }
    });
    return;
  }

  if (isPlaying) {
    // Reset outros botões primeiro
    document.querySelectorAll('.category-play-btn, .category-play-text-btn').forEach(btn => {
      if (btn !== button) {
        btn.classList.remove('playing');
        const svg = btn.querySelector('svg path');
        if (svg) svg.setAttribute('d', 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z');
        
        if (btn.classList.contains('category-play-text-btn')) {
          btn.innerHTML = `<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
          Reproduzir tudo`;
        }
      }
    });

    button.classList.add('playing');
    
    // Change to pause icon
    const svg = button.querySelector('svg path');
    if (svg) {
      svg.setAttribute('d', 'M6 19h4V5H6v14zm8-14v14h4V5h-4z'); // Pause icon
    }
    
    // Atualizar texto se for botão de texto
    if (button.classList.contains('category-play-text-btn') && customText) {
      button.innerHTML = `<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
      ${customText}`;
    }
  } else {
    button.classList.remove('playing');
    
    // Change to play icon
    const svg = button.querySelector('svg path');
    if (svg) {
      svg.setAttribute('d', 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z'); // Play icon
    }
    
    // Restaurar texto original se for botão de texto
    if (button.classList.contains('category-play-text-btn')) {
      const displayText = customText || 'Reproduzir tudo';
      button.innerHTML = `<svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
      ${displayText}`;
    }
  }
}
</script>

<!-- Modal de Login -->
<div id="loginModal" class="login-modal" style="display: none;">
  <div class="login-modal-overlay" onclick="closeLoginModal()"></div>
  <div class="login-modal-content">
    <div class="login-modal-header">
      <div class="login-modal-icon">
        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1V3H9V1L3 7V9H21ZM21 19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V11H21V19Z"/>
        </svg>
      </div>
    </div>
    <div class="login-modal-body">
      <p id="loginModalMessage" class="login-message">Precisa fazer login para seguir artista!</p>
      
      <form id="loginForm" class="login-form">
        <div class="login-input-group">
          <input type="email" id="loginEmail" name="email" placeholder="Email ou usuário" required>
        </div>
        
        <div class="login-input-group">
          <input type="password" id="loginPassword" name="password" placeholder="Senha" required>
        </div>
        
        <button type="submit" class="login-btn">Entrar</button>
      </form>
      
      <div class="login-links">
        <a href="#" onclick="showRegisterModal()" class="login-link">Cadastrar-se</a>
        <a href="#" onclick="showForgotModal()" class="login-link">Esqueci minha senha</a>
      </div>
    </div>
  </div>
</div>

<!-- Modal de Cadastro -->
<div id="registerModal" class="login-modal" style="display: none;">
  <div class="login-modal-overlay" onclick="closeRegisterModal()"></div>
  <div class="login-modal-content">
    <div class="login-modal-header">
      <div class="login-modal-icon">
        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1V3H9V1L3 7V9H21ZM21 19C21 20.1 20.1 21 19 21H5C3.9 21 3 20.1 3 19V11H21V19Z"/>
        </svg>
      </div>
    </div>
    <div class="login-modal-body">
      <p class="login-message">Criar sua conta e Nessa Banda Mekié</p>
      
      <form id="registerForm" class="login-form">
        <div class="login-input-group">
          <input type="text" id="registerNome" name="nome" placeholder="Nome completo" required>
        </div>
        
        <div class="login-input-group">
          <input type="email" id="registerEmail" name="email" placeholder="Email" required>
        </div>
        
        <div class="login-input-group">
          <input type="password" id="registerPassword" name="password" placeholder="Senha (mín. 6 caracteres)" required>
        </div>
        
        <div class="login-input-group">
          <input type="password" id="registerConfirmPassword" name="confirmPassword" placeholder="Confirmar senha" required>
        </div>
        
        <button type="submit" class="login-btn">Criar Conta</button>
      </form>
      
      <div class="login-links">
        <a href="#" onclick="showLoginFromRegister()" class="login-link">Já tem conta? Fazer login</a>
      </div>
    </div>
  </div>
</div>