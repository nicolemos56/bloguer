<header class="header">
  <nav class="navbar">
    <div class="navbar-container">
      <!-- Logo -->
      <div class="navbar-brand">
        <a href="/" class="brand-link">
          <img src="/assets/imagens/imagens_hme/ondas-sonoras.png" alt="VIB Music Logo" class="brand-logo">
          <span class="brand-text">VIB Music</span>
        </a>
      </div>

      <!-- Navigation Menu -->
      <ul class="navbar-menu" id="navbarMenu">
        <li class="navbar-item">
          <a href="/" class="navbar-link">Home</a>
        </li>
        <li class="navbar-item">
          <a href="/categorias" class="navbar-link">Categorias</a>
        </li>
        <li class="navbar-item">
          <a href="/divulgar" class="navbar-link">Divulgar</a>
        </li>
        <li class="navbar-item">
          <a href="#" class="navbar-link">Sobre</a>
        </li>
      </ul>

      <!-- Auth Section -->
      <div class="navbar-auth">
        <% if (isLoggedIn) { %>
          <div class="user-menu">
            <span class="user-greeting">Olá, <%= user.nome.split(' ')[0] %>!</span>
            <form action="/auth/logout" method="POST" style="display: inline;">
              <button type="submit" class="auth-btn logout-btn">Sair</button>
            </form>
          </div>
        <% } else { %>
          <div class="auth-buttons">
            <a href="/auth/login" class="auth-btn login-btn">Entrar</a>
            <a href="/auth/register" class="auth-btn register-btn">Criar Conta</a>
          </div>
        <% } %>
      </div>

      <!-- Mobile Menu Button -->
      <button class="navbar-toggle" id="navbarToggle" aria-label="Toggle navigation">
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
        <span class="toggle-bar"></span>
      </button>
    </div>
  </nav>
</header>